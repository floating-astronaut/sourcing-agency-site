# Copy to .env for local dev. Set the real values in the Cloudflare Pages
# dashboard (Project → Settings → Environment variables) for production —
# never commit real values here.

PUBLIC_SITE_URL=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
RESEND_AUTOREPLY=

# Optional extra lead sinks — leave unset to disable.
SLACK_WEBHOOK_URL=
CONTACT_FORWARD_URL=

# Optional — only needed if you wire up Meta Conversions API later.
META_CAPI_TOKEN=
META_PIXEL_ID=
