</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ay-faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('.ay-faq-q').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const a = b.nextElementSibling as HTMLElement | null;
        if (a) a.style.display = 'none';
      });
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        const a = btn.nextElementSibling as HTMLElement | null;
        if (a) a.style.display = 'block';
      }
    });
  });

  const io = new IntersectionObserver(
    (entries) => { entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }); },
    { threshold: 0.08, rootMargin: '0px 0px -50px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>
