---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';

const entries = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Base title="Case Studies" description="Selected sourcing case studies.">
  <section class="container-app pt-16 pb-10 md:pt-24">
    <p class="eyebrow"><Icon name="chart" size={14} /> Case Studies</p>
    <h1 class="mt-4">Receipts, not decks.</h1>
  </section>

  <section class="container-app pb-24">
    {entries.length === 0 ? (
      <div class="card p-8 md:p-10">
        <p class="text-fluid-lg">First case study is being drafted. Check back shortly.</p>
      </div>
    ) : (
      <ul role="list" class="grid gap-6 md:grid-cols-2">
        {entries.map((entry) => (
          <li>
            <a href={`/case-studies/${entry.slug}`} class="card p-6 md:p-8 block h-full transition-transform hover:-translate-y-0.5">
              <p class="text-fluid-xs text-subtle">{entry.data.client} · {entry.data.industry}</p>
              <h2 class="mt-3 text-fluid-2xl">{entry.data.headline}</h2>
              <p class="mt-3 text-muted text-fluid-sm">{entry.data.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-fluid-sm">
                Read case <Icon name="arrow-up-right" size={14} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
