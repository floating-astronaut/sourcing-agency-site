<script>
  document.querySelectorAll<HTMLButtonElement>('.pc-faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('.pc-faq-q').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const icon = b.querySelector('.pc-faq-icon') as HTMLElement | null;
        if (icon) icon.style.transform = 'rotate(0deg)';
        const a = b.nextElementSibling as HTMLElement | null;
        if (a) a.style.display = 'none';
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        const icon = btn.querySelector('.pc-faq-icon') as HTMLElement | null;
        if (icon) icon.style.transform = 'rotate(45deg)';
        const a = btn.nextElementSibling as HTMLElement | null;
        if (a) a.style.display = 'block';
      }
    });
  });
</script>
