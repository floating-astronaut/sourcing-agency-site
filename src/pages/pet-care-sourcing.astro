---
import Base from '~/layouts/Base.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import { site } from '~/lib/site';

const faqs = [
  { q: 'What are the minimum order quantities (MOQ)?', a: 'MOQs vary by product category: Himalayan Yak Chews start at 500 kg per SKU, soft chews from 1,000 units per formula, freeze-dried treats from 300 kg, and supplements from 2,000 units. For custom private label with new formulations, minimum trial runs start at 500–1,000 units. We can often negotiate lower MOQs for first sampling orders.' },
  { q: 'How long does a typical order take from enquiry to delivery?', a: 'Sampling takes 3–4 weeks. After sample approval, bulk production typically runs 6–10 weeks depending on category, followed by 3–5 weeks for ocean freight to US/UK/EU ports. Total lead time from first contact to delivery at your warehouse is typically 14–20 weeks for a first order, and 10–14 weeks for repeat orders.' },
  { q: 'How does the sample process work?', a: 'We coordinate sampling across our vetted manufacturer network — you receive multiple factory samples side by side. Our team handles sample sourcing, quality checks, and international courier delivery to your door. Sample costs are typically $150–400 per product category and are fully deductible from your first bulk order.' },
  { q: 'What certifications can your manufacturers provide?', a: 'Our network holds GMP, FSSAI (India\'s FDA equivalent), HACCP, ISO 22000, and APEDA export certifications. For US market products, we source from facilities with USDA-audited processes. Organic-certified (India Organic / USDA Organic) sourcing is available for select ingredients. We can provide full documentation packages for customs and regulatory submissions.' },
  { q: 'Can you handle custom formulations and private label packaging?', a: 'Yes — custom formulation (new recipes, ingredient swaps, functional additives) and full private label packaging design and production are core services. We work with your R&D team or can recommend formulation partners. Packaging options include stand-up pouches, kraft bags, jars, cans, and blister packs — all with your brand identity.' },
  { q: 'Which markets do you export to?', a: 'We primarily serve brands selling into the US, UK, EU, Canada, and Australia. Our team handles all export documentation (phytosanitary certificates, certificates of origin, lab test reports) required for customs clearance in each market.' },
  { q: 'Do you handle quality control and inspections?', a: 'Yes — every bulk order includes a pre-shipment quality inspection (AQL standard) conducted either by our team in India or a third-party inspection firm. Lab testing for contaminants, nutritional labelling compliance, and shelf-life validation are arranged on request.' },
] as const;
---

<Base title="Pet Care Sourcing — IndoFolk Wellness" description="Source premium pet products from India — Himalayan Yak Chews, private label treats, functional supplements, and freeze-dried formats. GMP-certified manufacturers, full export documentation.">
  <FAQSchema faqs={faqs} />

  <!-- Hero -->
  <section style="background:#0a192f; min-height:72vh; display:flex; align-items:center; position:relative; overflow:hidden; padding:5rem 5% 4rem;">
    <div style="position:absolute;inset:0;pointer-events:none;">
      <div style="position:absolute;top:-10%;right:-5%;width:600px;height:600px;background:radial-gradient(circle,rgba(37,99,235,0.2) 0%,transparent 65%);border-radius:50%;"></div>
      <div style="position:absolute;bottom:-15%;left:-8%;width:400px;height:400px;background:radial-gradient(circle,rgba(5,150,105,0.1) 0%,transparent 65%);border-radius:50%;"></div>
    </div>
    <div style="max-width:1180px;margin:0 auto;width:100%;position:relative;z-index:2;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(37,99,235,0.18);border:1px solid rgba(37,99,235,0.38);color:#93c5fd;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.38rem 1rem;border-radius:100px;margin-bottom:1.5rem;">
        <span style="width:7px;height:7px;border-radius:50%;background:#2563eb;display:inline-block;"></span>
        Pet Care Sourcing
      </div>
      <h1 style="font-size:clamp(2.6rem,5vw,4.5rem);font-weight:700;color:#fff;line-height:1.06;letter-spacing:-0.025em;margin-bottom:1.2rem;max-width:800px;">
        Private label pet products<br/><em style="color:#f59e0b;font-style:normal;">from India's best factories</em>
      </h1>
      <p style="font-size:1.08rem;color:rgba(255,255,255,0.65);line-height:1.8;max-width:580px;margin-bottom:2.5rem;font-weight:400;">
        IndoFolk Wellness connects pet brands in {site.markets.join(', ')} with GMP-certified Indian manufacturers — handling sampling, QC, labelling compliance, and export documentation end to end.
      </p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:3rem;">
        <a href={site.calendlyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;background:#2563eb;color:#fff;padding:0.9rem 2rem;border-radius:100px;font-weight:700;font-size:0.95rem;text-decoration:none;box-shadow:0 4px 24px rgba(37,99,235,0.35);">
          Book a Free Consultation ↗
        </a>
        <a href="/contact" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.85);padding:0.9rem 1.8rem;border-radius:100px;font-weight:500;font-size:0.95rem;text-decoration:none;border:1.5px solid rgba(255,255,255,0.22);">
          Request Samples
        </a>
      </div>
      <!-- Stats strip -->
      <div style="display:flex;gap:0;align-items:center;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:14px;overflow:hidden;max-width:560px;flex-wrap:wrap;">
        <div style="flex:1;padding:1rem;text-align:center;min-width:120px;">
          <strong style="display:block;font-size:1.7rem;font-weight:700;color:#f59e0b;line-height:1;">200+</strong>
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.42);text-transform:uppercase;letter-spacing:0.06em;display:block;margin-top:3px;">Vetted factories</span>
        </div>
        <div style="width:1px;background:rgba(255,255,255,0.07);align-self:stretch;"></div>
        <div style="flex:1;padding:1rem;text-align:center;min-width:120px;">
          <strong style="display:block;font-size:1.7rem;font-weight:700;color:#f59e0b;line-height:1;">24 hr</strong>
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.42);text-transform:uppercase;letter-spacing:0.06em;display:block;margin-top:3px;">First response</span>
        </div>
        <div style="width:1px;background:rgba(255,255,255,0.07);align-self:stretch;"></div>
        <div style="flex:1;padding:1rem;text-align:center;min-width:120px;">
          <strong style="display:block;font-size:1.7rem;font-weight:700;color:#f59e0b;line-height:1;">15+</strong>
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.42);text-transform:uppercase;letter-spacing:0.06em;display:block;margin-top:3px;">Export markets</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Product showcase -->
  <section style="padding:5rem 5%;background:#f8fafc;">
    <div style="max-width:1180px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#2563eb;margin-bottom:0.8rem;">
        <span style="width:22px;height:2px;background:#2563eb;display:inline-block;flex-shrink:0;"></span>
        Product Categories
      </div>
      <h2 style="font-size:clamp(2rem,3vw,2.8rem);font-weight:700;color:#0a192f;margin-bottom:0.6rem;letter-spacing:-0.02em;">Everything your brand needs — private label ready</h2>
      <p style="font-size:1rem;color:#64748b;max-width:600px;margin-bottom:3rem;line-height:1.8;">Six product categories, hundreds of SKU options, full custom formulation and packaging across each.</p>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-bottom:1.5rem;">

        <!-- Yak Chews -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;transition:all 0.35s;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/yak-cheese-branded.jpg" alt="Himalayan Yak Cheese branded packaging" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(220,50,20,0.88);color:#fff;">Best Seller</div>
            <div style="position:absolute;bottom:10px;right:10px;font-size:0.61rem;font-weight:600;background:rgba(255,255,255,0.93);color:#2563eb;padding:0.2rem 0.6rem;border-radius:100px;">Private Label Ready</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Himalayan Yak Chews</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Long-lasting hard chews sourced directly from Himalayan-region manufacturers. Small, medium, large, and XL sizes. Smoked, plain, and flavored variants. Custom branded bags and boxes.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">MOQ: 500 kg</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">GMP Certified</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">US/EU Export</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

        <!-- Functional Soft Chews -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/functional-treats.jpg" alt="Functional dog treats and packaging" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(37,99,235,0.9);color:#fff;">High Demand</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Functional Soft Chews</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Custom-formulated soft chews for joint support, skin & coat, digestive health, calming, and immunity. Available as biscuit, jerky, and soft chew textures with your branding.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">MOQ: 1,000 units</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">Custom Formula</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

        <!-- Freeze-Dried Treats -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/freeze-dried.jpg" alt="Freeze-dried treat varieties" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(5,150,105,0.88);color:#fff;">Growing</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Freeze-Dried Treats</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Single-ingredient and blended freeze-dried formats: chicken, beef, fish, and mixed protein. Raw nutrition retained. Available in resealable pouches, tins, and bulk formats.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">MOQ: 300 kg</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">HACCP</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

        <!-- Private Label Pouches -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/treats-pouches.jpg" alt="Chicken and fish treats in private label pouches" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(10,25,47,0.85);color:#fff;">Private Label</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Dried Meat Treats & Jerky</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Chicken strips, fish skins, lamb jerky, and mixed protein treat pouches with full private label packaging. Air-dried and dehydrated formats available with your brand's artwork.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">APEDA Certified</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">Full PL Design</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

        <!-- Pet Supplements -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/pet-supplements.jpg" alt="Pet supplement lineup" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(37,99,235,0.9);color:#fff;">High Margin</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Pet Supplements</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Hip & Joint, Omega-3, Probiotic, Multivitamin, and custom functional supplement formulas for dogs and cats. Tablet, capsule, powder, and liquid formats — white label or full custom.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">GMP Certified</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">MOQ: 2,000 units</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

        <!-- Private Label Packaging -->
        <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e2e8f0;display:flex;flex-direction:column;">
          <div style="position:relative;overflow:hidden;aspect-ratio:4/3;flex-shrink:0;">
            <img src="/images/products/private-label.jpg" alt="Private label packaging variety" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;top:12px;left:12px;font-size:0.63rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.22rem 0.65rem;border-radius:100px;background:rgba(10,25,47,0.85);color:#fff;">Full Service</div>
          </div>
          <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-size:1rem;font-weight:700;color:#0a192f;margin-bottom:0.4rem;">Custom Private Label</h3>
            <p style="font-size:0.82rem;color:#64748b;line-height:1.65;margin-bottom:0.8rem;flex:1;">Your brand on any product in our network. Pouches, kraft bags, jars, cans, boxes — full print management from dieline to delivery. Low minimum runs available for brand testing.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.8rem;">
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">Design Included</span>
              <span style="font-size:0.62rem;background:#f1f5f9;color:#64748b;padding:0.15rem 0.5rem;border-radius:4px;font-weight:500;">Low MOQ</span>
            </div>
            <a href="/contact" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#2563eb;font-weight:600;text-decoration:none;padding-top:0.65rem;border-top:1px solid #e2e8f0;margin-top:auto;">Request samples →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why India for pet products -->
  <section style="padding:5rem 5%;background:#0a192f;">
    <div style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;">
      <div>
        <div style="display:flex;align-items:center;gap:0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:0.8rem;">
          <span style="width:22px;height:2px;background:rgba(255,255,255,0.3);display:inline-block;"></span>
          Why India
        </div>
        <h2 style="font-size:clamp(1.8rem,2.8vw,2.6rem);font-weight:700;color:#fff;margin-bottom:0.8rem;letter-spacing:-0.015em;">India is the world's largest pet product sourcing hub</h2>
        <p style="font-size:0.95rem;color:rgba(255,255,255,0.55);line-height:1.85;margin-bottom:2rem;">India exports over $800M in pet products annually — combining traditional knowledge (like Himalayan yak chews) with modern GMP manufacturing at 30–50% lower cost than US or European alternatives.</p>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          {[
            { icon: '🏔️', title: 'Authentic Himalayan sourcing', desc: 'Yak cheese and Himalayan ingredients sourced from heritage supply chains — the real thing, not substitutes.' },
            { icon: '🏭', title: '200+ GMP-certified factories', desc: 'Our vetted network covers every pet product category with verifiable certifications for your target market.' },
            { icon: '📉', title: '30–50% cost advantage', desc: 'Comparable quality to US and EU manufacturing at a fraction of the cost — without compromising on compliance.' },
            { icon: '🚢', title: 'End-to-end export support', desc: 'Phytosanitary certificates, COO, FDA Prior Notice, and full customs documentation handled for every shipment.' },
          ].map(pt => (
            <div style="display:flex;gap:1rem;align-items:flex-start;padding:1rem 1.2rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;">
              <span style="font-size:1.3rem;width:36px;text-align:center;flex-shrink:0;">{pt.icon}</span>
              <div>
                <h5 style="font-size:0.9rem;font-weight:600;color:#fff;margin-bottom:0.25rem;">{pt.title}</h5>
                <p style="font-size:0.8rem;color:rgba(255,255,255,0.5);line-height:1.65;">{pt.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
          <div style="border-radius:18px;padding:1.8rem 1.4rem;text-align:center;background:#2563eb;">
            <strong style="display:block;font-size:2.4rem;font-weight:700;line-height:1;margin-bottom:0.4rem;color:#fff;">$800M+</strong>
            <span style="font-size:0.78rem;line-height:1.5;color:rgba(255,255,255,0.65);">India pet product exports annually</span>
          </div>
          <div style="border-radius:18px;padding:1.8rem 1.4rem;text-align:center;background:#059669;">
            <strong style="display:block;font-size:2.4rem;font-weight:700;line-height:1;margin-bottom:0.4rem;color:#fff;">200+</strong>
            <span style="font-size:0.78rem;line-height:1.5;color:rgba(255,255,255,0.65);">GMP-certified factories in our network</span>
          </div>
          <div style="border-radius:18px;padding:1.8rem 1.4rem;text-align:center;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);">
            <strong style="display:block;font-size:2.4rem;font-weight:700;line-height:1;margin-bottom:0.4rem;color:#f59e0b;">50%</strong>
            <span style="font-size:0.78rem;line-height:1.5;color:rgba(255,255,255,0.55);">Lower COGS vs US/EU manufacturing</span>
          </div>
