---
import Base from '~/layouts/Base.astro';
import { site } from '~/lib/site';
---

<Base
  title="Your India Office for Pet & Ayurvedic Sourcing — IndoFolk Wellness"
  description="IndoFolk Wellness is the India office international brands wish they already had. We find, vet, and manage GMP-certified manufacturers for pet and Ayurvedic products — from first sample to your door."
>

  <!-- ══════════════════════════════════════════════════════════
       §1  HERO — One image. One identity. One invitation.
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-hero" id="main">
    <div class="ifw-hero-sea" aria-hidden="true">
      <div class="ifw-hero-sky"></div>
      <span class="ifw-hero-glow"></span>
      <span class="ifw-hero-horizon"></span>
      <div class="ifw-hero-ship-track">
        <svg class="ifw-hero-ship" viewBox="0 0 260 84" xmlns="http://www.w3.org/2000/svg">
          <rect x="30" y="24" width="3" height="30"/>
          <rect x="44" y="34" width="46" height="20"/>
          <rect x="94" y="29" width="44" height="25"/>
          <rect x="142" y="37" width="46" height="17"/>
          <rect x="196" y="22" width="30" height="32"/>
          <rect x="206" y="12" width="10" height="12"/>
          <path d="M8 54 L252 54 L232 78 L28 78 Z"/>
        </svg>
      </div>
      <div class="ifw-hero-waves">
        <svg class="ifw-hero-wave ifw-hero-wave--back" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 60 C240 20 480 100 720 60 C960 20 1200 100 1440 60 L1440 120 L0 120 Z"/></svg>
        <svg class="ifw-hero-wave ifw-hero-wave--mid" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 70 C240 40 480 112 720 74 C960 38 1200 112 1440 74 L1440 120 L0 120 Z"/></svg>
        <svg class="ifw-hero-wave ifw-hero-wave--front" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 84 C240 60 480 120 720 88 C960 56 1200 120 1440 88 L1440 120 L0 120 Z"/></svg>
      </div>
    </div>
    <div class="ifw-hero-grad" aria-hidden="true"></div>
    <div class="ifw-hero-inner">
      <div class="ifw-hero-content">
        <p class="ifw-hero-eyebrow">B2B Sourcing Agency &nbsp;·&nbsp; New Delhi, India</p>
        <h1 class="ifw-hero-h1">We're your<br>India office.</h1>
        <p class="ifw-hero-desc">
          Pet care &amp; Ayurvedic products, sourced from India — sampled,
          inspected, and shipped by a team on the ground.
        </p>
        <a href="#contact" class="ifw-hero-cta">
          Begin the conversation
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <ul class="ifw-hero-trust" aria-label="What working with us looks like">
          <li>US · UK · EU importers</li>
          <li>GMP-aligned factories</li>
          <li>Personal on-site QC</li>
          <li>Export &amp; logistics managed</li>
        </ul>
      </div>
    </div>

    <a href="#statement" class="ifw-hero-scroll" aria-label="Scroll to learn more">
      <span class="ifw-hero-scroll-line" aria-hidden="true"></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </a>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §2  STATEMENT — The identity, unadorned.
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-stmt ds-bg-white" id="statement">
    <div class="ifw-stmt-inner">
      <p class="ifw-stmt-text" data-reveal>
        We are the India office<br>our clients wish they<br>already had.
      </p>
      <p class="ifw-stmt-sub" data-reveal data-delay="2">
        Not a vendor or a directory — a partner who thinks like your team,
        from inside the factories you cannot visit.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §3  SERVICES — What we do and why it matters
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-services ds-section ds-bg-cream">
    <div class="ds-container">
      <div class="ifw-services-grid">

        <div class="ifw-services-text">
          <span class="ds-eyebrow" data-reveal>What we do</span>
          <h2 class="ds-h2" data-reveal data-delay="1">Three ways<br>we work for you.</h2>

          <ol class="ifw-svc-list">
            <li class="ifw-svc-item" data-reveal data-delay="2">
              <span class="ifw-svc-num">01</span>
              <div>
                <h3 class="ifw-svc-name">Factory Matching</h3>
                <p class="ifw-svc-desc">GMP-certified manufacturers, personally visited and shortlisted to your brief.</p>
                <ul class="ds-chips">
                  <li class="ds-chip">3–5 factory shortlist</li>
                  <li class="ds-chip">48-hour turnaround</li>
                  <li class="ds-chip">Personally vetted</li>
                </ul>
              </div>
            </li>
            <li class="ifw-svc-item" data-reveal data-delay="3">
              <span class="ifw-svc-num">02</span>
              <div>
                <h3 class="ifw-svc-name">Quality &amp; Compliance</h3>
                <p class="ifw-svc-desc">First-hand inspection and certification checks before anything leaves India.</p>
                <ul class="ds-chips">
                  <li class="ds-chip">On-site inspection</li>
                  <li class="ds-chip">Certification verification</li>
                  <li class="ds-chip">Sample rounds managed</li>
                  <li class="ds-chip">Export-standard QC</li>
                </ul>
              </div>
            </li>
            <li class="ifw-svc-item" data-reveal data-delay="4">
              <span class="ifw-svc-num">03</span>
              <div>
                <h3 class="ifw-svc-name">Export &amp; Delivery</h3>
                <p class="ifw-svc-desc">Freight, customs, and logistics — handled your way, end-to-end.</p>
                <ul class="ds-chips">
                  <li class="ds-chip">Freight documentation</li>
                  <li class="ds-chip">Customs clearance</li>
                  <li class="ds-chip">Your forwarder or ours</li>
                </ul>
              </div>
            </li>
          </ol>

          <a href="/contact" class="ds-text-cta" data-reveal data-delay="5">
            Tell us about your project
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="ifw-services-img" data-reveal data-delay="1">
          <img
            src="/images/ifw/factory-verification-1.png"
            alt="IndoFolk Wellness team members conducting quality inspection on the factory production line"
            class="ifw-services-photo"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §4  PET PRODUCTS — Photography grid
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-pet ds-section ds-bg-white">
    <div class="ds-container">

      <div class="ifw-pet-header">
        <div>
          <span class="ds-eyebrow" data-reveal>Pet Product Sourcing</span>
          <h2 class="ds-h2" data-reveal data-delay="1">From India's finest<br>factories to your shelf.</h2>
        </div>
        <a href="/pet-care-sourcing" class="ds-text-cta ifw-pet-header-cta" data-reveal data-delay="2" aria-label="Explore all pet products">
          Explore all products
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="ifw-pet-grid">
        {[
          { img: 'product-yak-cheese.png', name: 'Yak Cheese Chews', desc: 'High-protein, lactose-free, long-lasting' },
          { img: 'product-meat-fish.png',  name: 'Meat & Fish Treats', desc: 'Single-protein, freeze-dried & air-dried' },
          { img: 'product-supplements.png', name: 'Pet Supplements', desc: 'Joint, gut, skin & coat formulations' },
          { img: 'product-functional-treats.png', name: 'Functional Treats', desc: 'Calming, dental, hip & joint blends' },
          { img: 'product-freeze-dried.png', name: 'Freeze-Dried', desc: 'Complete meals & toppers, raw nutrition' },
          { img: 'closing-brand-products.png', name: 'Private Label', desc: 'Custom formulations, your branding' },
        ].map((p, i) => (
          <a href="/pet-care-sourcing" class="ifw-pet-card" data-reveal data-delay={String((i % 3) + 1)} aria-label={`Learn more about ${p.name}`}>
            <div class="ifw-pet-card-img-wrap">
              <img
                src={`/images/ifw/${p.img}`}
                alt={p.name}
                class="ifw-pet-card-img"
                loading="lazy"
              />
              <span class="ifw-pet-card-scrim" aria-hidden="true"></span>
            </div>
            <div class="ifw-pet-card-body">
              <h3 class="ifw-pet-card-name">{p.name}</h3>
              <p class="ifw-pet-card-desc">{p.desc}</p>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §5  AYURVEDA — Editorial feature section
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-ayur ds-section ds-bg-subtle">
    <div class="ds-container">
      <div class="ifw-ayur-grid">

        <div class="ifw-ayur-img-wrap" data-reveal>
          <img
            src="/images/ifw/ayurveda-flatlay-2.png"
            alt="Premium Ayurvedic botanicals and extracts ready for international export"
            class="ifw-ayur-img"
            loading="lazy"
          />
        </div>

        <div class="ifw-ayur-text">
          <span class="ds-eyebrow" data-reveal>Ayurvedic Products</span>
          <h2 class="ds-h2" data-reveal data-delay="1">Pure Ayurveda.<br>Global standards.</h2>
          <p class="ds-body" data-reveal data-delay="2">
            India's Ayurvedic manufacturers are among the world's most
            regulated — WHO-GMP certified, AYUSH-licensed, and export-ready.
          </p>

          <ul class="ds-chips" data-reveal data-delay="3" style="margin-bottom:2.2rem">
            <li class="ds-chip">Ashwagandha &amp; Adaptogens</li>
            <li class="ds-chip">Triphala &amp; Digestive Blends</li>
            <li class="ds-chip">Brahmi &amp; Cognitive Herbs</li>
            <li class="ds-chip">Turmeric Complex &amp; Anti-Inflammatories</li>
            <li class="ds-chip">Neem, Moringa &amp; Superfoods</li>
            <li class="ds-chip">Shilajit &amp; Mineral Extracts</li>
          </ul>

          <a href="/ayurveda-sourcing" class="ds-text-cta" data-reveal data-delay="4">
            Explore Ayurvedic sourcing
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §6  INDIA ADVANTAGE — Dark, map-centred
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-india ds-section-lg ds-bg-dark">
    <div class="ds-container">

      <div class="ifw-india-header">
        <span class="ds-eyebrow ds-eyebrow-light" data-reveal>Why India</span>
        <h2 class="ds-h2 ds-h2-light" data-reveal data-delay="1">
          India. Naturally advanced.<br>Globally connected.
        </h2>
        <p class="ds-body ds-body-light" data-reveal data-delay="2">
          Deep botanical knowledge, modern GMP infrastructure, direct
          access to source — all in one place, so you don't have to be.
        </p>
        <ul class="ds-chips" data-reveal data-delay="2" style="margin-top:1.4rem">
          <li class="ds-chip ds-chip-light">Modern GMP infrastructure</li>
          <li class="ds-chip ds-chip-light">Direct-source ingredient access</li>
          <li class="ds-chip ds-chip-light">Embedded on the ground</li>
        </ul>
      </div>

      <div class="ifw-india-map" data-reveal data-delay="2">
        <img
          src="/images/ifw/india-map-regional.png"
          alt="Regional India sourcing map — key manufacturing clusters for pet and Ayurvedic products"
          class="ifw-india-map-img"
          loading="lazy"
        />
      </div>

      <div class="ifw-india-stats" data-reveal data-delay="3">
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num ds-stat-num-light">5,000+</span>
          <span class="ifw-india-stat-label ds-stat-label-light">Years of Ayurvedic knowledge</span>
        </div>
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num ds-stat-num-light">200+</span>
          <span class="ifw-india-stat-label ds-stat-label-light">Vetted manufacturers in our network</span>
        </div>
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num ds-stat-num-light">150+</span>
          <span class="ifw-india-stat-label ds-stat-label-light">Export destination countries</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §7  FACTORY STRIP — Full-bleed evidence photo
       ══════════════════════════════════════════════════════════ -->
  <div class="ifw-strip">
    <img
      src="/images/ifw/factory-gmp-verified.png"
      alt="GMP-verified Indian factory production line — IndoFolk Wellness quality verification in action"
      class="ifw-strip-img"
      loading="lazy"
    />
    <div class="ifw-strip-grad" aria-hidden="true"></div>
    <p class="ifw-strip-caption" data-reveal>GMP-verified &amp; personally inspected, on the factory floor.</p>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       §8  PROCESS — How we work
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-process ds-section ds-bg-white">
    <div class="ds-container">

      <div class="ifw-process-header">
        <span class="ds-eyebrow" data-reveal>How we work</span>
        <h2 class="ds-h2" data-reveal data-delay="1">Four steps from<br>brief to delivery.</h2>
      </div>

      <div class="ifw-process-grid">
        {[
          {
            n: '01',
            title: 'Brief us',
            body: 'Share your category, certifications, target MOQ, and timeline.',
            note: '~15-min call',
          },
          {
            n: '02',
            title: 'Receive your shortlist',
            body: '3–5 pre-vetted manufacturers — profiles, certifications, pricing.',
            note: '~48 hours',
          },
          {
            n: '03',
            title: 'Approve your sample',
            body: 'We source and inspect samples until you sign off. Nothing proceeds without it.',
            note: '~2–4 weeks',
          },
          {
            n: '04',
            title: 'Receive your delivery',
            body: 'Production oversight, export documentation, and freight — to your door.',
            note: '~6–10 weeks',
          },
        ].map((step, i) => (
          <div class="ifw-process-step" data-reveal data-delay={String(i + 1)}>
            <div class="ifw-process-node">
              <span class="ifw-process-num">{step.n}</span>
            </div>
            <div class="ifw-process-card">
              <h3 class="ifw-process-title">{step.title}</h3>
              <p class="ifw-process-body">{step.body}</p>
              <ul class="ds-chips"><li class="ds-chip ifw-process-note">{step.note}</li></ul>
            </div>
          </div>
        ))}
      </div>

      <div class="ifw-process-cta" data-reveal>
        <a href={site.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Book a 30-minute call
        </a>
        <a href="/contact" class="ds-text-cta">
          Or send us a message
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §9  CLOSING — Cinematic final CTA
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-closing">
    <img
      src="/images/ifw/closing-port-figure.png"
      alt="A contemplative figure overlooking a shipping port at dusk — representing the bridge between India and global markets"
      class="ifw-closing-bg"
      loading="lazy"
    />
    <div class="ifw-closing-grad" aria-hidden="true"></div>
    <div class="ifw-closing-inner">
      <p class="ifw-closing-eyebrow" data-reveal>Ready to begin?</p>
      <h2 class="ifw-closing-h2" data-reveal data-delay="1">
        Begin the<br>conversation.
      </h2>
      <p class="ifw-closing-body" data-reveal data-delay="2">
        Detailed brief or just a category — we'll have a sourcing plan
        back to you within 24 hours.
      </p>
      <div class="ifw-closing-ctas" data-reveal data-delay="3">
        <a href={site.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Book a call
        </a>
        <a href={`mailto:${site.contactEmail}`} class="btn-ghost-light btn">
          Email us directly
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §10 CONTACT — Founder + quick form
       ══════════════════════════════════════════════════════════ -->
  <section id="contact" class="ifw-contact ds-section ds-bg-cream">
    <div class="ds-container">
      <div class="ifw-contact-grid">

        <!-- Left: founder -->
        <div class="ifw-contact-founder" data-reveal>
          <div class="ifw-founder-img-wrap">
            <img
              src="/images/ifw/founder-divyanshu.png"
              alt="Divyanshu, Founder of IndoFolk Wellness, with his dogs"
              class="ifw-founder-img"
              loading="lazy"
            />
          </div>
          <div class="ifw-founder-bio">
            <p class="ifw-founder-name">Divyanshu</p>
            <p class="ifw-founder-role">Founder, IndoFolk Wellness</p>
            <p class="ifw-founder-note">
              "We built this agency so the India-to-global supply chain feels
              like having someone trustworthy on the ground — not like
              navigating it blind."
            </p>
            <div class="ifw-founder-links">
              <a href={`mailto:${site.contactEmail}`} class="ds-text-cta">
                {site.contactEmail}
              </a>
              <a href={`tel:${site.phone.replace(/\s+/g,'')}`} class="ifw-founder-phone">
                {site.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="ifw-contact-form-wrap" data-reveal data-delay="2">
          <span class="ds-eyebrow">Get in touch</span>
          <h2 class="ds-h3" style="margin-bottom:1.8rem">Tell us about<br>your project.</h2>

          <form
            class="ifw-form"
            method="POST"
            action={`mailto:${site.contactEmail}`}
            enctype="text/plain"
          >
            <div class="ifw-form-row">
              <div class="ds-form-field">
                <label for="f-name" class="ds-form-label">Your name</label>
                <input id="f-name" name="name" type="text" class="ds-form-input" placeholder="Jane Smith" required />
              </div>
              <div class="ds-form-field">
                <label for="f-company" class="ds-form-label">Company / Brand</label>
                <input id="f-company" name="company" type="text" class="ds-form-input" placeholder="Acme Pet Co." required />
              </div>
            </div>

            <div class="ifw-form-row">
              <div class="ds-form-field">
                <label for="f-email" class="ds-form-label">Email address</label>
                <input id="f-email" name="email" type="email" class="ds-form-input" placeholder="jane@brand.com" required />
              </div>
              <div class="ds-form-field">
                <label for="f-country" class="ds-form-label">Country</label>
                <input id="f-country" name="country" type="text" class="ds-form-input" placeholder="United States" />
              </div>
            </div>

            <div class="ds-form-field">
              <label for="f-category" class="ds-form-label">Product category</label>
              <select id="f-category" name="category" class="ds-form-input">
                <option value="">Select category…</option>
                <option>Pet Care</option>
                <option>Ayurveda / Wellness</option>
                <option>Both</option>
                <option>Other</option>
              </select>
            </div>

            <div class="ds-form-field">
              <label for="f-message" class="ds-form-label">Tell us about your project</label>
              <textarea id="f-message" name="message" class="ds-form-input ds-form-textarea" placeholder="Product category, target market, MOQ, certifications needed…" rows="4"></textarea>
            </div>

            <button type="submit" class="ds-submit">Send message</button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Base>

<style is:global>

/* ═══════════════════════════════════════════════════════════
   HOMEPAGE — ifw- scoped styles
   ═══════════════════════════════════════════════════════════ */

/* ── §1 Hero ─────────────────────────────────────────────── */
.ifw-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #141E16;
}
/* Animated maritime scene — dusk sea + drifting cargo ship + waves */
.ifw-hero-sea { position: absolute; inset: 0; overflow: hidden; }
.ifw-hero-sky {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, #15271c 0%, #122019 40%, #0d1812 66%, #0a130e 100%);
}
.ifw-hero-glow {
  position: absolute; top: 8%; right: 10%;
  width: 54vw; height: 54vw; max-width: 660px; max-height: 660px;
  background: radial-gradient(circle, rgba(184,150,12,0.24) 0%, rgba(184,150,12,0.07) 36%, transparent 62%);
  filter: blur(4px); pointer-events: none;
}
.ifw-hero-horizon {
  position: absolute; left: 0; right: 0; top: 57%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,178,64,0.40) 46%, rgba(212,178,64,0.18) 62%, transparent);
}
.ifw-hero-ship-track {
  position: absolute; top: 49%; left: 0;
  width: clamp(150px, 19vw, 270px);
  animation: heroShipDrift 64s linear infinite;
  will-change: transform;
}
@keyframes heroShipDrift {
  from { transform: translateX(-30vw); }
  to   { transform: translateX(130vw); }
}
.ifw-hero-ship {
  display: block; width: 100%; height: auto;
  fill: #070d09; opacity: 0.42;
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.45));
  animation: heroShipBob 6.5s ease-in-out infinite;
}
@keyframes heroShipBob {
  0%, 100% { transform: translateY(0) rotate(-0.35deg); }
  50% { transform: translateY(-5px) rotate(0.35deg); }
}
.ifw-hero-waves { position: absolute; left: -4%; right: -4%; bottom: 0; height: 44%; }
.ifw-hero-wave { position: absolute; left: 0; bottom: 0; width: 108%; height: 100%; }
.ifw-hero-wave--back  { fill: rgba(23,45,32,0.85);  animation: heroWave 13s ease-in-out infinite; }
.ifw-hero-wave--mid   { fill: rgba(15,32,22,0.92);  animation: heroWave 9.5s ease-in-out infinite reverse; }
.ifw-hero-wave--front { fill: #0a130e;              animation: heroWave 7.5s ease-in-out infinite; }
@keyframes heroWave {
  0%, 100% { transform: translateX(0) translateY(0); }
  50% { transform: translateX(-3%) translateY(-4px); }
}
@media (prefers-reduced-motion: reduce) {
  .ifw-hero-ship-track { animation: none; transform: translateX(58vw); }
  .ifw-hero-ship, .ifw-hero-wave { animation: none; }
}
.ifw-hero-grad {
  position: absolute; inset: 0;
  background:
    linear-gradient(
      108deg,
      rgba(14,20,15,0.96) 0%,
      rgba(16,24,18,0.84) 34%,
      rgba(18,27,20,0.48) 56%,
      rgba(20,30,22,0.10) 82%
    ),
    linear-gradient(
      0deg,
      rgba(10,15,11,0.55) 0%,
      rgba(10,15,11,0.0) 30%,
      rgba(10,15,11,0.0) 78%,
      rgba(10,15,11,0.45) 100%
    );
}
.ifw-hero-inner {
  position: relative; z-index: 2;
  max-width: 1180px; margin: 0 auto;
  padding: 9rem 5% 7rem; width: 100%;
}
.ifw-hero-content { max-width: 510px; }
.ifw-hero-eyebrow {
  font-size: 0.67rem; font-weight: 600;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(250,248,244,0.40);
  margin-bottom: 1.8rem; margin-top: 0;
}
.ifw-hero-h1 {
  font-size: clamp(3.4rem, 6.5vw, 5.4rem); font-weight: 800;
  line-height: 1.0; letter-spacing: -0.036em;
  color: #FAF8F4; margin: 0 0 1.6rem;
}
.ifw-hero-desc {
  font-size: 1.0rem; line-height: 1.9;
  color: rgba(250,248,244,0.56);
  max-width: 390px; margin: 0 0 2.4rem;
}
.ifw-hero-cta {
  display: inline-flex; align-items: center; gap: 8px;
  color: #FAF8F4; font-size: 0.88rem; font-weight: 600;
  letter-spacing: 0.01em; text-decoration: none;
  padding-bottom: 3px; border-bottom: 1px solid rgba(250,248,244,0.28);
  transition: color 0.28s, border-color 0.28s;
}
.ifw-hero-cta:hover { color: #B8960C; border-color: #B8960C; }
.ifw-hero-cta svg { transition: transform 0.28s; flex-shrink: 0; }
.ifw-hero-cta:hover svg { transform: translateX(4px); }

/* Trust strip — qualitative capability chips, no invented numbers */
.ifw-hero-trust {
  list-style: none; margin: 2.6rem 0 0; padding: 1.5rem 0 0;
  border-top: 1px solid rgba(250,248,244,0.14);
  display: flex; flex-wrap: wrap; gap: 0.6rem 0.7rem;
}
.ifw-hero-trust li {
  font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.02em;
  color: rgba(250,248,244,0.72);
  background: rgba(250,248,244,0.06);
  border: 1px solid rgba(250,248,244,0.14);
  border-radius: 999px;
  padding: 0.42rem 0.9rem;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

/* Scroll-down cue */
.ifw-hero-scroll {
  position: absolute; z-index: 3;
  left: 50%; bottom: 2.2rem;
  transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
  color: rgba(250,248,244,0.55);
  text-decoration: none;
  transition: color 0.25s, transform 0.25s;
}
.ifw-hero-scroll:hover { color: #B8960C; transform: translateX(-50%) translateY(3px); }
.ifw-hero-scroll-line {
  width: 1px; height: 2.2rem;
  background: linear-gradient(180deg, rgba(250,248,244,0.05), currentColor);
}
.ifw-hero-scroll svg { animation: heroScrollBob 2.2s ease-in-out infinite; }
@keyframes heroScrollBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4px); }
}
@media (prefers-reduced-motion: reduce) {
  .ifw-hero-scroll svg { animation: none; }
}
@media (max-width: 640px) {
  .ifw-hero-inner { padding: 7rem 6% 5rem; }
  .ifw-hero-h1 { font-size: clamp(3rem, 11vw, 4rem); }
  .ifw-hero-desc { max-width: 100%; }
  .ifw-hero-grad {
    background:
      linear-gradient(180deg,rgba(16,24,18,0.90) 0%,rgba(18,27,20,0.72) 55%,rgba(20,30,22,0.55) 100%);
  }
  .ifw-hero-bg { object-position: 60% 28%; }
  .ifw-closing-bg { object-position: center center; }
  .ifw-hero-scroll { display: none; }
}

/* ── §2 Statement ────────────────────────────────────────── */
.ifw-stmt {
  padding: 11rem 5%;
  border-bottom: 1px solid #DCD5C9;
}
.ifw-stmt-inner {
  max-width: 1180px; margin: 0 auto;
}
.ifw-stmt-text {
  font-size: clamp(2.6rem, 5vw, 4.4rem);
  font-weight: 800; line-height: 1.07;
  letter-spacing: -0.033em;
  color: #1C1814;
  max-width: 720px; margin: 0 0 3.5rem;
}
.ifw-stmt-sub {
  font-size: 1.05rem; line-height: 1.85;
  color: #6B6358; max-width: 500px;
  margin-left: auto;
}
@media (max-width: 640px) {
  .ifw-stmt { padding: 6rem 5%; }
  .ifw-stmt-text { font-size: clamp(2rem, 9vw, 3rem); }
  .ifw-stmt-sub { margin-left: 0; }
}

/* ── §3 Services ─────────────────────────────────────────── */
.ifw-services-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 5rem;
  align-items: start;
}
.ifw-services-text .ds-h2 { margin: 0 0 2.8rem; }
.ifw-svc-list {
  list-style: none; padding: 0; margin: 0 0 2.5rem;
  display: flex; flex-direction: column; gap: 1.1rem;
}
.ifw-svc-item {
  display: grid;
  grid-template-columns: 3.4rem 1fr;
  gap: 0.9rem;
  align-items: start;
  padding: 1.5rem 1.6rem;
  background: #fff;
  border: 1px solid rgb(var(--color-border));
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--dur) var(--ease-out-expo),
              transform var(--dur) var(--ease-out-expo),
              border-color var(--dur) var(--ease-out-expo);
}
.ifw-svc-item:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
  border-color: rgb(var(--color-brand) / 0.25);
}
.ifw-svc-num {
  display: flex; align-items: center; justify-content: center;
  width: 2.6rem; height: 2.6rem;
  border-radius: 50%;
  background: rgb(var(--color-brand) / 0.06);
  border: 1px solid rgb(var(--color-copper) / 0.30);
  font-size: 0.78rem; font-weight: 800;
  letter-spacing: 0.02em;
  color: #B8960C;
}
.ifw-svc-name {
  font-size: 1rem; font-weight: 700;
  color: #1C1814; margin: 0 0 0.5rem;
  letter-spacing: -0.01em;
}
.ifw-svc-desc {
  font-size: 0.88rem; line-height: 1.6;
  color: #6B6358; margin: 0 0 0.9rem;
}
.ifw-services-img {
  position: sticky; top: 5rem;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
}
.ifw-services-photo {
  width: 100%; border-radius: var(--radius-xl);
  object-fit: cover;
  object-position: center center;
  aspect-ratio: 4/5;
  display: block;
}
@media (max-width: 900px) {
  .ifw-services-grid { grid-template-columns: 1fr; gap: 3rem; }
  .ifw-services-img { position: static; order: -1; }
  .ifw-services-photo { aspect-ratio: 16/9; }
}

/* ── §4 Pet Products ─────────────────────────────────────── */
.ifw-pet-header {
  display: flex; align-items: flex-end;
  justify-content: space-between;
  gap: 2rem; margin-bottom: 3rem;
}
.ifw-pet-header .ds-h2 { margin: 0; }
.ifw-pet-header-cta { flex-shrink: 0; margin-bottom: 0.3rem; }

.ifw-pet-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.ifw-pet-card {
  text-decoration: none; color: inherit;
  display: flex; flex-direction: column;
  border-radius: var(--radius-lg); overflow: hidden;
  border: 1px solid #DCD5C9;
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--dur) var(--ease-out-expo),
              transform var(--dur) var(--ease-out-expo),
              border-color var(--dur) var(--ease-out-expo);
  background: #fff;
}
/* Featured first card — breaks the uniform 3×2 grid */
.ifw-pet-card:first-child {
  grid-column: 1 / 3;
}
.ifw-pet-card:first-child .ifw-pet-card-img-wrap {
  aspect-ratio: 16/7;
}
.ifw-pet-card:first-child .ifw-pet-card-name {
  font-size: 1.05rem;
}
.ifw-pet-card:first-child .ifw-pet-card-body {
  padding: 1.6rem 1.8rem 1.8rem;
}
.ifw-pet-card:hover, .ifw-pet-card:focus-visible {
  box-shadow: var(--shadow-lg);
  transform: translateY(-5px);
  border-color: rgb(var(--color-brand) / 0.30);
}
.ifw-pet-card-img-wrap {
  overflow: hidden; aspect-ratio: 4/3;
  flex-shrink: 0; position: relative;
}
.ifw-pet-card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.55s cubic-bezier(0.16,1,0.3,1);
  display: block;
}
.ifw-pet-card:hover .ifw-pet-card-img, .ifw-pet-card:focus-visible .ifw-pet-card-img { transform: scale(1.06); }
.ifw-pet-card-scrim {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(20,30,22,0) 55%, rgba(20,30,22,0.28) 100%);
  opacity: 0;
  transition: opacity 0.35s ease;
}
.ifw-pet-card:hover .ifw-pet-card-scrim, .ifw-pet-card:focus-visible .ifw-pet-card-scrim { opacity: 1; }
.ifw-pet-card-body {
  padding: 1.2rem 1.4rem 1.4rem;
  flex: 1;
}
.ifw-pet-card-name {
  font-size: 0.93rem; font-weight: 700;
  color: #1C1814; margin: 0 0 0.3rem;
  letter-spacing: -0.01em;
}
.ifw-pet-card-desc {
  font-size: 0.80rem; line-height: 1.6;
  color: #6B6358; margin: 0;
}
@media (max-width: 860px) {
  .ifw-pet-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .ifw-pet-grid { grid-template-columns: repeat(2, 1fr); }
  .ifw-pet-card:first-child { grid-column: 1 / -1; }
  .ifw-pet-card:first-child .ifw-pet-card-img-wrap { aspect-ratio: 16/9; }
}
@media (max-width: 520px) {
  .ifw-pet-grid { grid-template-columns: 1fr; }
  .ifw-pet-card:first-child { grid-column: 1; }
  .ifw-pet-card:first-child .ifw-pet-card-img-wrap { aspect-ratio: 4/3; }
}

/* ── §5 Ayurveda ─────────────────────────────────────────── */
.ifw-ayur-grid {
  display: grid;
  grid-template-columns: 46% 54%;
  gap: 6rem; align-items: center;
}
.ifw-ayur-img-wrap {
  border-radius: var(--radius-xl); overflow: hidden;
  aspect-ratio: 4/5;
  box-shadow: var(--shadow-lg);
}
.ifw-ayur-img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.ifw-ayur-text .ds-h2 { margin: 0 0 1.4rem; }
.ifw-ayur-text .ds-body { margin-bottom: 1.6rem; }
@media (max-width: 860px) {
  .ifw-ayur-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .ifw-ayur-img-wrap { aspect-ratio: 16/9; }
}

/* ── §6 India Advantage ──────────────────────────────────── */
.ifw-india-header {
  max-width: 640px; margin-bottom: 3.5rem;
}
.ifw-india-header .ds-h2 { margin: 0 0 1.4rem; }
.ifw-india-map {
  border-radius: var(--radius-xl); overflow: hidden;
  margin-bottom: 3.5rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.10);
  box-shadow: 0 28px 60px -18px rgba(0,0,0,0.55), 0 2px 0 rgba(255,255,255,0.04) inset;
}
.ifw-india-map-img {
  width: 100%; display: block;
  max-height: 560px; object-fit: cover;
}
.ifw-india-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 2.5rem;
}
.ifw-india-stat {
  display: flex; flex-direction: column; gap: 0.4rem;
  position: relative;
  padding-left: 1.8rem;
}
.ifw-india-stat::before {
  content: '';
  position: absolute; left: 0; top: 0.2rem;
  width: 2px; height: 2.6rem;
  background: linear-gradient(180deg, rgb(var(--color-copper)), rgba(184,150,12,0));
}
.ifw-india-stat:first-child { padding-left: 0; }
.ifw-india-stat:first-child::before { display: none; }
.ifw-india-stat-num {
  font-size: clamp(3rem, 6.5vw, 6rem);
  font-weight: 800; letter-spacing: -0.04em;
  line-height: 1;
}
.ifw-india-stat-label {
  font-size: 0.78rem; line-height: 1.5;
  margin-top: 0.5rem;
}
@media (max-width: 640px) {
  .ifw-india-stats { grid-template-columns: 1fr; gap: 1.8rem; }
  .ifw-india-stat { padding-left: 0; padding-top: 1.4rem; }
  .ifw-india-stat::before {
    left: 0; top: 0; width: 2.4rem; height: 2px;
    background: linear-gradient(90deg, rgb(var(--color-copper)), rgba(184,150,12,0));
  }
  .ifw-india-stat:first-child { padding-top: 0; }
}

/* ── §7 Factory Strip ────────────────────────────────────── */
.ifw-strip {
  height: 62vh; min-height: 380px;
  overflow: hidden; position: relative;
}
.ifw-strip-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 15%;
  display: block;
}
.ifw-strip-grad {
  position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(14,20,15,0.62) 0%, rgba(14,20,15,0.0) 32%, rgba(14,20,15,0.0) 78%, rgba(14,20,15,0.28) 100%);
}
.ifw-strip-caption {
  position: absolute; left: 5%; bottom: 1.8rem; z-index: 2;
  margin: 0;
  font-size: 0.78rem; font-weight: 600;
  letter-spacing: 0.01em;
  color: #FAF8F4;
  background: rgba(20,30,22,0.42);
  border: 1px solid rgba(250,248,244,0.16);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 999px;
  padding: 0.55rem 1.1rem;
}
@media (max-width: 640px) {
  .ifw-strip-caption { font-size: 0.72rem; left: 6%; right: 6%; }
}

/* ── §8 Process ──────────────────────────────────────────── */
.ifw-process-header {
  max-width: 560px; margin-bottom: 3.5rem;
}
.ifw-process-header .ds-h2 { margin: 0; }
.ifw-process-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem 2.5rem;
  margin-bottom: 3.5rem;
}
/* Connecting rail between the numbered nodes (desktop 4-up only) */
.ifw-process-grid::before {
  content: '';
  position: absolute;
  left: 12.5%; right: 12.5%; top: 1.55rem;
  height: 2px;
  background: repeating-linear-gradient(
    90deg,
    rgb(var(--color-border)) 0, rgb(var(--color-border)) 8px,
    transparent 8px, transparent 14px
  );
  z-index: 0;
}
.ifw-process-step {
  position: relative; z-index: 1;
}
.ifw-process-node {
  display: flex; align-items: center; justify-content: center;
  width: 3.1rem; height: 3.1rem;
  border-radius: 50%;
  background: #FAF8F4;
  border: 1.5px solid rgb(var(--color-copper) / 0.45);
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.4rem;
  position: relative; z-index: 1;
}
.ifw-process-num {
  font-size: 1.05rem; font-weight: 800;
  letter-spacing: -0.02em;
  color: #B8960C;
  line-height: 1;
}
.ifw-process-card {
  background: #fff;
  border: 1px solid rgb(var(--color-border));
  border-radius: var(--radius-lg);
  padding: 1.5rem 1.4rem 1.6rem;
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--dur) var(--ease-out-expo), transform var(--dur) var(--ease-out-expo);
  height: 100%;
}
.ifw-process-step:hover .ifw-process-card {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.ifw-process-title {
  font-size: 1rem; font-weight: 700;
  color: #1C1814; margin: 0 0 0.6rem;
  letter-spacing: -0.01em;
}
.ifw-process-body {
  font-size: 0.84rem; line-height: 1.6;
  color: #6B6358; margin: 0 0 0.9rem;
}
.ifw-process-note {
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.04em; text-transform: uppercase;
  color: #A0978A;
}
.ifw-process-cta {
  display: flex; align-items: center; gap: 2.5rem;
  flex-wrap: wrap;
}
@media (max-width: 900px) {
  .ifw-process-grid { grid-template-columns: repeat(2, 1fr); }
  .ifw-process-grid::before { display: none; }
}
@media (max-width: 540px) {
  .ifw-process-grid { grid-template-columns: 1fr; }
  .ifw-process-cta { gap: 1.5rem; }
}

/* ── §9 Closing ──────────────────────────────────────────── */
.ifw-closing {
  position: relative; min-height: 80vh;
  display: flex; align-items: center;
  background: #141E16; overflow: hidden;
}
.ifw-closing-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 35%;
}
.ifw-closing-grad {
  position: absolute; inset: 0;
  background:
    linear-gradient(
      108deg,
      rgba(14,20,15,0.95) 0%,
      rgba(16,24,18,0.78) 42%,
      rgba(18,27,20,0.46) 68%,
      rgba(20,30,22,0.15) 100%
    ),
    linear-gradient(
      0deg,
      rgba(10,15,11,0.35) 0%,
      rgba(10,15,11,0.0) 26%
    );
}
.ifw-closing-inner {
  position: relative; z-index: 2;
  max-width: 1180px; margin: 0 auto;
  padding: 7rem 5%; width: 100%;
}
.ifw-closing-eyebrow {
  font-size: 0.67rem; font-weight: 600;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(250,248,244,0.38);
  margin: 0 0 1.4rem;
}
.ifw-closing-h2 {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 800; line-height: 1.0;
  letter-spacing: -0.035em;
  color: #FAF8F4; margin: 0 0 1.5rem;
}
.ifw-closing-body {
  font-size: 1rem; line-height: 1.85;
  color: rgba(250,248,244,0.52);
  max-width: 400px; margin-bottom: 2.5rem;
}
.ifw-closing-ctas {
  display: flex; align-items: center;
  gap: 1.2rem; flex-wrap: wrap;
}
.ifw-closing-ctas .btn-primary { box-shadow: var(--shadow-brand); }
.ifw-closing-ctas .btn-ghost-light { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
.ifw-closing-ctas .btn-ghost-light:hover { box-shadow: 0 10px 26px -10px rgba(184,150,12,0.35); }

/* ── §10 Contact ─────────────────────────────────────────── */
.ifw-contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem; align-items: start;
}
.ifw-founder-img-wrap {
  border-radius: var(--radius-xl); overflow: hidden;
  aspect-ratio: 3/4; margin-bottom: 1.8rem;
  box-shadow: var(--shadow-lg);
}
.ifw-founder-img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.ifw-founder-name {
  font-size: 1.2rem; font-weight: 800;
  color: #1C1814; margin: 0 0 0.15rem;
  letter-spacing: -0.02em;
}
.ifw-founder-role {
  font-size: 0.78rem; color: #6B6358;
  margin: 0 0 1.2rem;
  font-weight: 500;
}
.ifw-founder-note {
  font-size: 0.90rem; line-height: 1.85;
  color: #6B6358; font-style: italic;
  margin: 0 0 1.4rem;
  max-width: 400px;
  padding-left: 1.1rem;
  border-left: 2px solid rgb(var(--color-copper) / 0.45);
}
.ifw-founder-links {
  display: flex; flex-direction: column; gap: 0.55rem;
}
.ifw-founder-phone {
  font-size: 0.84rem; color: #6B6358;
  text-decoration: none;
  transition: color 0.2s;
}
