---
// TODO: every string on this page is placeholder copy — replace with real
// positioning, services, process, and proof once the brand brief is final.
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ContactForm from '~/components/ContactForm.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import { site } from '~/lib/site';

const services = [
  {
    icon: 'target' as const,
    title: 'Supplier Sourcing',
    blurb: 'We find and shortlist vetted manufacturers matched to your product spec, MOQ, and budget.',
  },
  {
    icon: 'shield' as const,
    title: 'Factory Audits & QC',
    blurb: 'On-the-ground factory audits and pre-shipment quality inspections, with photo/video evidence.',
  },
  {
    icon: 'layers' as const,
    title: 'Sample Management',
    blurb: 'We coordinate sampling rounds across multiple factories so you can compare quality side by side.',
  },
  {
    icon: 'link' as const,
    title: 'Logistics & Freight Forwarding',
    blurb: 'Door-to-door freight, customs documentation, and consolidation across air and ocean.',
  },
  {
    icon: 'cpu' as const,
    title: 'Private Label / OEM',
    blurb: 'End-to-end private-label production — from spec sheet to branded, packaged, shipped product.',
  },
] as const;

const steps = [
  { n: '01', title: 'Brief', body: 'Tell us the product, target price, MOQ, and timeline.' },
  { n: '02', title: 'Source', body: 'We shortlist 3–5 vetted factories matched to your spec.' },
  { n: '03', title: 'Vet & Audit', body: 'Factory audits and capability checks before you commit.' },
  { n: '04', title: 'Sample', body: 'Coordinated sampling rounds, compared side by side.' },
  { n: '05', title: 'Order & Inspect', body: 'Production tracking plus pre-shipment QC.' },
  { n: '06', title: 'Ship', body: 'Freight, customs, and delivery handled door to door.' },
] as const;

const faqs = [
  { q: 'What products do you source?', a: 'TODO — list the product categories this agency actually covers.' },
  { q: 'What are your fees?', a: 'TODO — describe the pricing model (retainer, per-project, % of order value, etc.).' },
  { q: 'What regions do you source from?', a: 'TODO — name the sourcing regions/countries covered.' },
  { q: 'How long does a typical sourcing project take?', a: 'TODO — give a realistic timeline range.' },
];
---

<Base title="Sourcing, Vetted." description={site.description}>
  <section class="container-app pt-24 pb-16 md:pt-32 md:pb-20">
    <p class="eyebrow"><Icon name="target" size={14} /> Sourcing agency</p>
    <h1 class="mt-5 max-w-3xl text-fluid-5xl font-bold tracking-tight leading-[1.02]">
      We find, vet, and manage the <span class="gradient-text">factories</span> that make your product.
    </h1>
    <p class="mt-6 max-w-2xl text-fluid-lg text-muted">
      {site.tagline} From first supplier search to landed freight — one team, one point of contact.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#contact" class="btn btn-primary text-fluid-base px-6 py-3.5">
        Get a Quote <Icon name="arrow-right" size={16} />
      </a>
      <a href="#services" class="btn btn-secondary text-fluid-base px-6 py-3.5">
        See services
      </a>
    </div>
  </section>

  <section id="services" class="py-16 md:py-20 border-y border-border/40 bg-surface/20">
    <div class="container-app">
      <p class="eyebrow"><Icon name="layers" size={14} /> What we do</p>
      <h2 class="mt-4">Services</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="card p-6">
            <span class="inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
              <Icon name={s.icon} size={18} />
            </span>
            <h3 class="mt-4 text-fluid-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-fluid-sm text-muted">{s.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="py-16 md:py-20">
    <div class="container-app">
      <p class="eyebrow"><Icon name="bolt" size={14} /> Process</p>
      <h2 class="mt-4">How it works</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((s) => (
          <div class="card p-6">
            <span class="font-mono text-fluid-sm text-brand">{s.n}</span>
            <h3 class="mt-2 text-fluid-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-fluid-sm text-muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 border-y border-border/40 bg-surface/20">
    <div class="container-app">
      <p class="eyebrow"><Icon name="chart" size={14} /> Case studies</p>
      <h2 class="mt-4">Receipts, not promises.</h2>
      <p class="mt-4 max-w-xl text-muted">TODO — link real case studies here once available.</p>
      <a href="/case-studies" class="btn btn-secondary mt-6">
        View case studies <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </section>

  <section id="faq" class="py-16 md:py-20">
    <FAQSchema faqs={faqs} />
    <div class="container-app max-w-3xl">
      <p class="eyebrow"><Icon name="spark" size={14} /> FAQ</p>
      <h2 class="mt-4">Frequently asked questions</h2>
      <div class="mt-8 grid gap-4">
        {faqs.map((f) => (
          <details class="card p-5">
            <summary class="cursor-pointer font-medium">{f.q}</summary>
            <p class="mt-3 text-fluid-sm text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="py-16 md:py-20 border-t border-border/40">
    <div class="container-app grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow"><Icon name="send" size={14} /> Get a quote</p>
        <h2 class="mt-4">Tell us what you're sourcing.</h2>
        <p class="mt-5 text-fluid-lg text-muted">
          Reply within one business day. If it's urgent,
          <a href={`mailto:${site.contactEmail}`} class="text-brand underline decoration-brand/40 hover:decoration-brand">{site.contactEmail}</a>.
        </p>
      </div>
      <div class="md:col-span-7">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
