  .ifw-live-step > div:last-child strong { display: block; color: #fff; font-size: 0.86rem; font-weight: 600; }
  .ifw-live-step > div:last-child span { font-size: 0.76rem; color: rgba(255,255,255,0.4); line-height: 1.4; }
  .ifw-live-check { width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: rgba(255,255,255,0.7); flex-shrink: 0; }
  .ifw-done .ifw-live-check { background: rgba(5,150,105,0.22); border-color: rgba(5,150,105,0.4); color: #34d399; }
  .ifw-check-orange { background: rgba(37,99,235,0.2) !important; border-color: rgba(37,99,235,0.4) !important; color: #93c5fd !important; }
  .ifw-float-badge { position: absolute; bottom: -16px; right: -12px; background: #f8fafc; border-radius: 16px; padding: 1.1rem 1.4rem; text-align: center; box-shadow: 0 12px 40px rgba(0,0,0,0.18); min-width: 120px; }
  .ifw-float-num { font-size: 1.7rem; color: #2563eb; font-weight: 700; line-height: 1; }
  .ifw-float-label { font-size: 0.7rem; color: #64748b; margin-top: 4px; line-height: 1.4; }

  /* ── Trust Bar ── */
  .ifw-trust-bar { background: #f1f5f9; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; padding: 1.1rem 5%; display: flex; align-items: center; justify-content: center; gap: 2rem; flex-wrap: wrap; }
  .ifw-trust-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: #64748b; font-weight: 600; }
  .ifw-trust-flags { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
  .ifw-flag { font-size: 0.84rem; color: #0a192f; font-weight: 500; }
  .ifw-trust-certs { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .ifw-cert { font-size: 0.72rem; font-weight: 600; color: #059669; background: rgba(5,150,105,0.1); padding: 0.2rem 0.7rem; border-radius: 100px; }

  /* ── Promise ── */
  .ifw-promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .ifw-blockquote { font-size: clamp(1.2rem, 2vw, 1.6rem); font-style: italic; line-height: 1.5; color: #0a192f; margin: 1.5rem 0 1.8rem; padding-left: 1.4rem; border-left: 3px solid #2563eb; }
  .ifw-promise-cards { display: flex; flex-direction: column; gap: 1rem; }
  .ifw-pcard { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.4rem; display: flex; gap: 1.1rem; align-items: flex-start; transition: all 0.28s; }
  .ifw-pcard:hover { border-color: #2563eb; box-shadow: 0 8px 28px rgba(37,99,235,0.08); transform: translateX(4px); }
  .ifw-pcard-icon { width: 42px; height: 42px; border-radius: 12px; background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0; }
  .ifw-pcard h4 { font-size: 0.94rem; font-weight: 600; color: #0a192f; margin-bottom: 0.3rem; }
  .ifw-pcard p { font-size: 0.84rem; color: #64748b; line-height: 1.65; }

  /* ── Category Panels ── */
  .ifw-cat-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem; }
  .ifw-cat-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .ifw-cat-panel { background: #fff; border-radius: 22px; border: 1px solid #e2e8f0; overflow: hidden; padding: 1.8rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .ifw-panel-pet { border-top: 4px solid #2563eb; }
  .ifw-panel-ayur { border-top: 4px solid #059669; }
  .ifw-panel-header { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .ifw-panel-icon { width: 48px; height: 48px; border-radius: 14px; background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
  .ifw-panel-ayur .ifw-panel-icon { background: #ecfdf5; }
  .ifw-panel-header h3 { font-size: 1.4rem; font-weight: 700; color: #0a192f; }
  .ifw-panel-header p { font-size: 0.8rem; color: #64748b; }
  .ifw-panel-badge { margin-left: auto; background: #2563eb; color: #fff; font-size: 0.65rem; font-weight: 700; padding: 0.22rem 0.7rem; border-radius: 100px; letter-spacing: 0.05em; text-transform: uppercase; }
  .ifw-panel-products { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .ifw-pprod { display: flex; align-items: center; gap: 0.8rem; padding: 0.7rem 0.8rem; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; transition: border-color 0.2s; }
  .ifw-pprod:hover { border-color: rgba(37,99,235,0.35); }
  .ifw-pprod-icon { font-size: 1.3rem; flex-shrink: 0; width: 32px; text-align: center; }
  .ifw-pprod strong { display: block; font-size: 0.86rem; font-weight: 600; color: #0a192f; }
  .ifw-pprod span { font-size: 0.75rem; color: #64748b; }
  .ifw-pprod-tag { margin-left: auto; flex-shrink: 0; font-size: 0.62rem; font-weight: 700; padding: 0.18rem 0.55rem; border-radius: 100px; background: #f1f5f9; color: #64748b; white-space: nowrap; }
  .ifw-tag-hot { background: rgba(37,99,235,0.1); color: #2563eb; }
  .ifw-tag-new { background: rgba(5,150,105,0.1); color: #059669; }
  .ifw-panel-cta { display: inline-flex; align-items: center; justify-content: center; background: #2563eb; color: #fff; padding: 0.8rem 1.5rem; border-radius: 100px; font-weight: 600; font-size: 0.88rem; text-decoration: none; transition: all 0.25s; }
  .ifw-panel-cta:hover { background: #1d4ed8; }
  .ifw-panel-cta-green { background: #059669; }
  .ifw-panel-cta-green:hover { background: #047857; }
  .ifw-cat-footer { text-align: center; font-size: 0.9rem; color: #64748b; }
  .ifw-cat-footer a { color: #2563eb; font-weight: 600; text-decoration: none; }
  .ifw-cat-footer a:hover { text-decoration: underline; }

  /* ── Why India ── */
  .ifw-why-india-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .ifw-why-pts { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }
  .ifw-why-pt { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 1.2rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; transition: border-color 0.2s; }
  .ifw-why-pt:hover { border-color: rgba(37,99,235,0.5); }
  .ifw-why-pt-icon { font-size: 1.3rem; width: 36px; text-align: center; flex-shrink: 0; }
  .ifw-why-pt h5 { font-size: 0.9rem; font-weight: 600; color: #fff; margin-bottom: 0.25rem; }
  .ifw-why-pt p { font-size: 0.8rem; color: rgba(255,255,255,0.5); line-height: 1.65; }

  /* Stats mosaic */
  .ifw-stats-mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  .ifw-stat-tile { border-radius: 18px; padding: 1.8rem 1.4rem; text-align: center; }
  .ifw-stat-terra { background: #2563eb; }
  .ifw-stat-sage  { background: #059669; }
  .ifw-stat-parch { background: rgba(255,255,255,0.08); }
  .ifw-stat-deep  { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
  .ifw-stat-tile strong { display: block; font-size: 2.4rem; font-weight: 700; line-height: 1; margin-bottom: 0.4rem; }
  .ifw-stat-terra strong, .ifw-stat-sage strong, .ifw-stat-deep strong { color: #fff; }
  .ifw-stat-parch strong { color: #f59e0b; }
  .ifw-stat-tile span { font-size: 0.78rem; line-height: 1.5; }
  .ifw-stat-terra span, .ifw-stat-sage span, .ifw-stat-deep span { color: rgba(255,255,255,0.65); }
  .ifw-stat-parch span { color: rgba(255,255,255,0.55); }

  /* Comparison table */
  .ifw-compare-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 1.5rem; }
  .ifw-compare-title { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-bottom: 1rem; }
  .ifw-compare-scroll { overflow-x: auto; }
  .ifw-compare-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .ifw-compare-table thead th { padding: 0.5rem 0.8rem; text-align: left; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.4); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .ifw-compare-table td { padding: 0.6rem 0.8rem; color: rgba(255,255,255,0.65); border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
  .ifw-compare-table tr:last-child td { border-bottom: none; }
  .ifw-col-no { color: rgba(255,100,100,0.85) !important; }
  .ifw-col-yes { color: #34d399 !important; font-weight: 600; }
  .ifw-compare-table thead .ifw-col-no { color: rgba(255,100,100,0.45) !important; }
  .ifw-compare-table thead .ifw-col-yes { color: rgba(52,211,153,0.55) !important; }

  /* ── Process ── */
  .ifw-process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-bottom: 3rem; }
  .ifw-proc-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 1.8rem; transition: all 0.3s; position: relative; overflow: hidden; }
  .ifw-proc-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #2563eb, #f59e0b); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .ifw-proc-card:hover::before { transform: scaleX(1); }
  .ifw-proc-card:hover { box-shadow: 0 12px 36px rgba(37,99,235,0.1); }
  .ifw-proc-num { font-size: 3.5rem; font-weight: 700; color: rgba(37,99,235,0.1); line-height: 1; margin-bottom: 0.4rem; }
  .ifw-proc-icon { font-size: 1.5rem; margin-bottom: 0.8rem; }
  .ifw-proc-card h3 { font-size: 0.96rem; font-weight: 700; color: #0a192f; margin-bottom: 0.5rem; }
  .ifw-proc-card p { font-size: 0.84rem; color: #64748b; line-height: 1.7; }
  .ifw-proc-time { margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid #e2e8f0; font-size: 0.75rem; color: #2563eb; font-weight: 600; }
  .ifw-process-cta { display: flex; align-items: center; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
  .ifw-process-note { font-size: 0.84rem; color: #64748b; }

  /* ── Why Indofolk ── */
  .ifw-why-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .ifw-why-rows { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.5rem; }
  .ifw-why-row { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem 1.2rem; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; transition: all 0.25s; }
  .ifw-why-row:hover { border-color: #2563eb; }
  .ifw-why-check { width: 24px; height: 24px; border-radius: 50%; background: rgba(37,99,235,0.1); color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 0.76rem; flex-shrink: 0; font-weight: 700; margin-top: 1px; }
  .ifw-why-row h5 { font-size: 0.92rem; font-weight: 600; color: #0a192f; margin-bottom: 0.2rem; }
  .ifw-why-row p { font-size: 0.82rem; color: #64748b; line-height: 1.65; }

  /* Stats 2x2 */
  .ifw-stats-2x2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .ifw-stat2 { border-radius: 18px; padding: 1.6rem 1.3rem; text-align: center; }
  .ifw-s2-terra { background: #2563eb; }
  .ifw-s2-sage  { background: #059669; }
  .ifw-s2-light { background: #f1f5f9; }
  .ifw-s2-dark  { background: #0a192f; }
  .ifw-stat2 strong { display: block; font-size: 2.5rem; font-weight: 700; line-height: 1; margin-bottom: 0.4rem; }
  .ifw-s2-terra strong, .ifw-s2-sage strong, .ifw-s2-dark strong { color: #fff; }
  .ifw-s2-light strong { color: #2563eb; }
  .ifw-stat2 span { font-size: 0.76rem; line-height: 1.5; }
  .ifw-s2-terra span, .ifw-s2-sage span, .ifw-s2-dark span { color: rgba(255,255,255,0.65); }
  .ifw-s2-light span { color: #64748b; }

  /* Cert grid */
  .ifw-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .ifw-cert-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.2rem; text-align: center; }
  .ifw-cert-icon { font-size: 1.8rem; margin-bottom: 0.5rem; }
  .ifw-cert-card h4 { font-size: 0.84rem; font-weight: 700; color: #0a192f; margin-bottom: 0.25rem; }
  .ifw-cert-card p { font-size: 0.74rem; color: #64748b; line-height: 1.55; }

  /* ── Testimonials ── */
  .ifw-testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 3rem; }
  .ifw-testi-card { background: #fff; border-radius: 20px; padding: 2rem; border: 1px solid #e2e8f0; transition: all 0.3s; }
  .ifw-testi-card:hover { box-shadow: 0 14px 44px rgba(37,99,235,0.1); transform: translateY(-5px); }
  .ifw-testi-quote { display: block; font-size: 5rem; color: rgba(37,99,235,0.1); line-height: 0.8; margin-bottom: 0.5rem; }
  .ifw-testi-stars { color: #f59e0b; font-size: 0.85rem; letter-spacing: 2px; margin-bottom: 1rem; }
  .ifw-testi-text { font-size: 0.92rem; line-height: 1.8; color: #64748b; font-style: italic; margin-bottom: 1.5rem; font-weight: 400; }
  .ifw-testi-author { display: flex; align-items: center; gap: 0.8rem; }
  .ifw-testi-avatar { width: 40px; height: 40px; border-radius: 50%; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 700; flex-shrink: 0; }
  .ifw-testi-author strong { display: block; font-size: 0.88rem; color: #0a192f; }
  .ifw-testi-author span { font-size: 0.76rem; color: #64748b; }

  /* ── FAQ ── */
  .ifw-faq-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 5rem; }
  .ifw-faq-left p { font-size: 0.95rem; line-height: 1.8; color: #64748b; font-weight: 400; margin-top: 1rem; margin-bottom: 1.5rem; }
  .ifw-faq-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: #2563eb; font-weight: 600; text-decoration: none; transition: gap 0.2s; }
  .ifw-faq-link:hover { gap: 12px; }
  .ifw-faq-list { display: flex; flex-direction: column; }
  .ifw-faq-item { border-bottom: 1px solid #e2e8f0; }
  .ifw-faq-q { width: 100%; padding: 1.3rem 0; background: none; border: none; font-size: 0.94rem; font-weight: 600; color: #0a192f; display: flex; justify-content: space-between; align-items: center; cursor: pointer; gap: 1rem; text-align: left; }
  .ifw-faq-q:hover { color: #2563eb; }
  .ifw-faq-icon { color: #2563eb; font-size: 1.2rem; flex-shrink: 0; transition: transform 0.25s; }
  .ifw-faq-q[aria-expanded="true"] .ifw-faq-icon { transform: rotate(45deg); }
  .ifw-faq-a { font-size: 0.88rem; color: #64748b; line-height: 1.8; font-weight: 400; padding-bottom: 1.2rem; display: none; }
  .ifw-faq-a.open { display: block; }

  /* ── Contact ── */
  .ifw-contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; position: relative; z-index: 2; }
  .ifw-contact-checks { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 2rem; }
  .ifw-ccheck { display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,0.8); font-size: 0.88rem; }
  .ifw-ccheck::before { content: '✓'; width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; flex-shrink: 0; }
  .ifw-calendly-block { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; text-align: center; }
  .ifw-calendly-title { font-size: 0.8rem; color: rgba(255,255,255,0.6); margin-bottom: 0.8rem; }
  .ifw-calendly-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #fff; color: #2563eb; padding: 0.9rem 1.8rem; border-radius: 100px; font-weight: 700; font-size: 0.92rem; text-decoration: none; transition: all 0.25s; width: 100%; }
  .ifw-calendly-btn:hover { background: #f59e0b; color: #0a192f; }
  .ifw-calendly-sub { font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.6rem; }
  .ifw-contact-or { display: flex; align-items: center; gap: 1rem; margin: 0.8rem 0 0.5rem; }
  .ifw-contact-or::before, .ifw-contact-or::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.15); }
  .ifw-contact-or span { font-size: 0.75rem; color: rgba(255,255,255,0.35); }
  .ifw-contact-direct { display: flex; flex-direction: column; gap: 0.6rem; }
  .ifw-wa-btn, .ifw-email-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 0.75rem 1.2rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
  .ifw-wa-btn { background: rgba(37,211,102,0.15); border: 1px solid rgba(37,211,102,0.3); color: #5de89a; }
  .ifw-wa-btn:hover { background: rgba(37,211,102,0.25); }
  .ifw-email-btn { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.8); }
  .ifw-email-btn:hover { background: rgba(255,255,255,0.18); }

  /* Form */
  .ifw-form-card { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 22px; padding: 2.2rem; backdrop-filter: blur(10px); }
  .ifw-form-title { font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 0.3rem; }
  .ifw-form-sub { font-size: 0.82rem; color: rgba(255,255,255,0.5); margin-bottom: 1.5rem; }
  .ifw-form { display: flex; flex-direction: column; gap: 0.9rem; }
  .ifw-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .ifw-form-group { display: flex; flex-direction: column; gap: 0.3rem; }
  .ifw-form-group label { font-size: 0.76rem; font-weight: 600; color: rgba(255,255,255,0.7); }
  .ifw-req { color: rgba(255,200,150,0.8); }
  .ifw-input { width: 100%; padding: 0.82rem 1rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; color: #fff; font-size: 0.88rem; outline: none; transition: border-color 0.2s; appearance: none; -webkit-appearance: none; }
  .ifw-input::placeholder { color: rgba(255,255,255,0.3); }
  .ifw-input:focus { border-color: rgba(255,255,255,0.55); background: rgba(255,255,255,0.15); }
  .ifw-input option { background: #0a192f; color: #fff; }
  .ifw-textarea { resize: vertical; min-height: 100px; }
  .ifw-submit-btn { width: 100%; padding: 1rem 1.5rem; background: #fff; color: #2563eb; border: none; border-radius: 10px; font-size: 0.96rem; font-weight: 700; cursor: pointer; transition: all 0.25s; letter-spacing: 0.02em; margin-top: 0.4rem; }
  .ifw-submit-btn:hover { background: #f59e0b; color: #0a192f; transform: translateY(-1px); }

  /* ── Product Image Cards ── */
  .ifw-cat-sub-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .ifw-cat-sub-label { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .ifw-cat-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 700; padding: 0.35rem 1rem; border-radius: 100px; }
  .ifw-cat-pill-orange { background: rgba(37,99,235,0.1); color: #2563eb; border: 1.5px solid rgba(37,99,235,0.25); }
  .ifw-cat-pill-green { background: rgba(5,150,105,0.1); color: #059669; border: 1.5px solid rgba(5,150,105,0.25); }
  .ifw-cat-note { font-size: 0.85rem; color: #64748b; }
  .ifw-cat-sub-cta { font-size: 0.85rem; font-weight: 600; color: #2563eb; text-decoration: none; white-space: nowrap; }
  .ifw-cat-sub-cta:hover { text-decoration: underline; }

