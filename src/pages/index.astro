---
import Base from '~/layouts/Base.astro';
import { site } from '~/lib/site';
---

<Base
  title="India's #1 Sourcing Agency for Pet & Ayurvedic Products"
  description="Indofolk Wellness is India's trusted B2B sourcing agency. We find the perfect Indian manufacturer, negotiate the best price, manage quality, and deliver to your door. Free consultation."
>
  <Fragment slot="head">
    <!-- Inter Tight Variable is loaded globally via @fontsource-variable/inter-tight -->
  </Fragment>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="ifw-hero">
    <div class="ifw-hero-bg">
      <div class="ifw-hero-glow"></div>
      <div class="ifw-hero-glow2"></div>
    </div>
    <div class="ifw-hero-inner">
      <div class="ifw-hero-left">
        <div class="ifw-badge">
          <span class="ifw-badge-dot"></span>
          India's Trusted B2B Sourcing Partner
        </div>
        <h1 class="ifw-h1">
          Your <em>India Office</em> for Pet &amp; Ayurvedic Sourcing
        </h1>
        <p class="ifw-hero-lead">
          Tell us what you need. We find the perfect Indian manufacturer, negotiate your price, manage quality, handle shipping — and deliver to your door. <strong>You grow your brand. We handle India.</strong>
        </p>
        <div class="ifw-hero-ctas">
          <a href={site.calendlyUrl} target="_blank" rel="noopener" class="ifw-btn-primary">
            📅 Book a Free Consultation
          </a>
          <a href="#contact" class="ifw-btn-ghost">Post an Inquiry →</a>
        </div>
        <div class="ifw-hero-proof">
          <div class="ifw-proof-item">
            <strong>48h</strong>
            <span>Manufacturer shortlist</span>
          </div>
          <div class="ifw-proof-divider"></div>
          <div class="ifw-proof-item">
            <strong>200+</strong>
            <span>Vetted factories</span>
          </div>
          <div class="ifw-proof-divider"></div>
          <div class="ifw-proof-item">
            <strong>15+</strong>
            <span>Export countries</span>
          </div>
          <div class="ifw-proof-divider"></div>
          <div class="ifw-proof-item">
            <strong>24h</strong>
            <span>First response</span>
          </div>
        </div>
      </div>
      <div class="ifw-hero-right">
        <div class="ifw-live-card">
          <div class="ifw-live-tag">
            <span class="ifw-live-dot"></span> Live Sourcing Example
          </div>
          <blockquote class="ifw-live-quote">
            "We need organic dog treats — natural ingredients, our brand label, shipped to the UK."
          </blockquote>
          <div class="ifw-live-steps">
            <div class="ifw-live-step ifw-done">
              <div class="ifw-live-check">✓</div>
              <div>
                <strong>3 manufacturers shortlisted &amp; vetted</strong>
                <span>GMP certified, UK-export ready, within 48 hours</span>
              </div>
            </div>
            <div class="ifw-live-step ifw-done">
              <div class="ifw-live-check">✓</div>
              <div>
                <strong>Price negotiated — 26% below initial quote</strong>
                <span>Final pricing locked before any commitment</span>
              </div>
            </div>
            <div class="ifw-live-step ifw-active">
              <div class="ifw-live-check ifw-check-orange">→</div>
              <div>
                <strong>Samples dispatched to London</strong>
                <span>Arriving in 8 days for client approval</span>
              </div>
            </div>
          </div>
        </div>
        <div class="ifw-float-badge">
          <div class="ifw-float-num">1–2%</div>
          <div class="ifw-float-label">Our fee.<br>Savings cover it.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       TRUST / MARKETS BAR
  ══════════════════════════════════════════════ -->
  <div class="ifw-trust-bar">
    <span class="ifw-trust-label">Sourcing for brands in</span>
    <div class="ifw-trust-flags">
      <span class="ifw-flag">🇺🇸 United States</span>
      <span class="ifw-flag">🇦🇪 UAE</span>
      <span class="ifw-flag">🇬🇧 United Kingdom</span>
      <span class="ifw-flag">🇩🇪 Germany</span>
      <span class="ifw-flag">🇦🇺 Australia</span>
      <span class="ifw-flag">🇨🇦 Canada</span>
    </div>
    <div class="ifw-trust-certs">
      <span class="ifw-cert">GMP ✓</span>
      <span class="ifw-cert">USDA Organic ✓</span>
      <span class="ifw-cert">ISO 9001 ✓</span>
      <span class="ifw-cert">FSSAI ✓</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       WHAT WE DO — Promise
  ══════════════════════════════════════════════ -->
  <section class="ifw-section ifw-bg-cream" id="about">
    <div class="ifw-container">
      <div class="ifw-promise-grid">
        <div class="ifw-promise-left">
          <div class="ifw-eyebrow">Our Promise</div>
          <h2 class="ifw-sh">We don't just find<br>suppliers. We find <em>the right one.</em></h2>
          <blockquote class="ifw-blockquote">
            "We understand that every brand has different needs — quality bars, certifications, budgets, and timelines. That's why we never send you a generic list. We listen first."
          </blockquote>
          <p class="ifw-body-text">
            India is home to thousands of manufacturers. Most are good. A few are exceptional. The difference between a mediocre supplier and the right one can make or break your product line.
          </p>
          <p class="ifw-body-text">
            At Indofolk Wellness, we've built relationships with India's best factories — the ones that deliver on time, maintain quality across batches, hold the right certifications, and understand what global brands need.
          </p>
          <a href="#contact" class="ifw-btn-primary" style="display:inline-flex;margin-top:1.5rem">Tell Us What You Need →</a>
        </div>
        <div class="ifw-promise-cards">
          <div class="ifw-pcard">
            <div class="ifw-pcard-icon">🎯</div>
            <div>
              <h4>We Listen Before We Search</h4>
              <p>Every engagement starts with a briefing call. We understand your product, market, customers, and standards — before we approach a single manufacturer.</p>
            </div>
          </div>
          <div class="ifw-pcard">
            <div class="ifw-pcard-icon">🤝</div>
            <div>
              <h4>We Negotiate On Your Side</h4>
              <p>We know real factory prices. We know where there's room. You get the best deal — we handle every back-and-forth so you don't have to.</p>
            </div>
          </div>
          <div class="ifw-pcard">
            <div class="ifw-pcard-icon">🧪</div>
            <div>
              <h4>We Never Skip Quality</h4>
              <p>Samples are checked by us before they reach you. Production batches are monitored. We are your eyes and ears in India.</p>
            </div>
          </div>
          <div class="ifw-pcard">
            <div class="ifw-pcard-icon">🚀</div>
            <div>
              <h4>We Make It Genuinely Easy</h4>
              <p>One point of contact. Clear updates at every step. No chasing manufacturers, no language barriers, no confusing logistics. Just results, delivered.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       PRODUCT CATEGORIES
  ══════════════════════════════════════════════ -->
  <section class="ifw-section ifw-bg-sand" id="products">
    <div class="ifw-container">
      <div class="ifw-cat-header">
        <div>
          <div class="ifw-eyebrow">What We Source</div>
          <h2 class="ifw-sh" style="margin-bottom:0">Two Specialisations. <em>One Expert Partner.</em></h2>
        </div>
      </div>

      <!-- Pet Products Subheading -->
      <div class="ifw-cat-sub-head">
        <div class="ifw-cat-sub-label">
          <span class="ifw-cat-pill ifw-cat-pill-orange">🐾 Pet Products</span>
          <span class="ifw-cat-note">Our primary focus — India's fastest-growing export category</span>
        </div>
        <a href="#contact" class="ifw-cat-sub-cta">Source Pet Products →</a>
      </div>

      <!-- Pet Product Image Cards Grid -->
      <div class="ifw-prod-grid">

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/yak-cheese-branded.jpg" alt="Himalayan Yak Cheese Dog Chews — branded packaging with natural chew bars, private label ready" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-hot">🔥 #1 Seller</span>
            <span class="ifw-prod-pl-tag">Private Label Ready</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Yak Cheese Chews</h4>
            <p class="ifw-prod-desc">100% natural Himalayan yak milk chews — lactose-free, long-lasting, high-protein. Bestseller in US &amp; UK markets.</p>
            <div class="ifw-prod-tags">
              <span>Natural</span><span>Lactose-Free</span><span>Human-Grade</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/treats-pouches.jpg" alt="Chicken jerky and fish treats in custom private label pouches with dog breed photos" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-demand">High Demand</span>
            <span class="ifw-prod-pl-tag">Private Label Ready</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Chicken, Fish &amp; Meat Treats</h4>
            <p class="ifw-prod-desc">Chicken jerky, fish skins, salmon strips — single-ingredient, air-dried, human-grade. In your brand's packaging.</p>
            <div class="ifw-prod-tags">
              <span>Single Ingredient</span><span>Air-Dried</span><span>Human-Grade</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/pet-supplements.jpg" alt="Pet supplement range — Hip and Joint, Omega-3 Oil, Probiotic, Digestive Enzymes, Multivitamin, Calcium" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-pl">Private Label</span>
            <span class="ifw-prod-pl-tag">Custom Formula</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Pet Supplements</h4>
            <p class="ifw-prod-desc">Hip &amp; Joint, Omega-3, Digestive Enzymes, Probiotic, Multivitamin, Calcium — vet-formulated, in your brand.</p>
            <div class="ifw-prod-tags">
              <span>Vet-Formulated</span><span>Tablet / Capsule</span><span>Custom SKUs</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/functional-treats.jpg" alt="Functional dog treats and bone-shaped biscuits with turmeric, omega-3 and natural ingredients" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-hot">Herbal Formula</span>
            <span class="ifw-prod-pl-tag">Private Label Ready</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Functional Treats &amp; Biscuits</h4>
            <p class="ifw-prod-desc">Soft chews &amp; bone-shaped biscuits with Glucosamine, Turmeric, Omega-3. Treats with a purpose — joint, calming, immunity.</p>
            <div class="ifw-prod-tags">
              <span>Soft Chew</span><span>Herbal</span><span>Joint Health</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/freeze-dried.jpg" alt="Freeze-dried pet treats variety — chicken cubes, salmon pieces and whole dried fish" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-new">Trending</span>
            <span class="ifw-prod-pl-tag">Private Label Ready</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Freeze-Dried Treats</h4>
            <p class="ifw-prod-desc">Freeze-dried chicken, salmon, fish — raw nutrition, clean label. Premium positioning for upscale pet brands.</p>
            <div class="ifw-prod-tags">
              <span>Raw Nutrition</span><span>Clean Label</span><span>Premium</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card">
          <div class="ifw-prod-img-wrap">
            <img src="/images/products/private-label.jpg" alt="Private label pet product packaging range — custom pouches, jars and boxes with brand designs" loading="lazy" />
            <span class="ifw-prod-overlay-badge ifw-badge-pl">Your Brand</span>
            <span class="ifw-prod-pl-tag">All Categories</span>
          </div>
          <div class="ifw-prod-body">
            <h4 class="ifw-prod-title">Private Label Ready</h4>
            <p class="ifw-prod-desc">Every product available under your brand — custom packaging, OEM formulations, retail-ready from GMP-certified factories.</p>
            <div class="ifw-prod-tags">
              <span>Custom Packaging</span><span>OEM</span><span>GMP Certified</span>
            </div>
            <a href="#contact" class="ifw-prod-cta">Get Started →</a>
          </div>
        </div>

      </div>

      <!-- Ayurvedic Products Subheading -->
      <div class="ifw-cat-sub-head" style="margin-top:3.5rem">
        <div class="ifw-cat-sub-label">
          <span class="ifw-cat-pill ifw-cat-pill-green">🌿 Ayurvedic Products</span>
          <span class="ifw-cat-note">Certified organic herbs, oils &amp; formulations</span>
        </div>
        <a href="#contact" class="ifw-cat-sub-cta">Source Ayurvedic Products →</a>
      </div>

      <!-- Ayurvedic Products: list + photo -->
      <div class="ifw-ayur-grid">
        <div class="ifw-ayur-products">
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🪨</span>
            <div><strong>Shilajit</strong><span>Resin, powder, capsule — lab-verified purity, fulvic acid certified</span></div>
            <span class="ifw-pprod-tag ifw-tag-hot">Premium</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🌱</span>
            <div><strong>Ashwagandha</strong><span>USDA Organic, KSM-66 &amp; Sensoril certified, root extract</span></div>
            <span class="ifw-pprod-tag ifw-tag-hot">Best Seller</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🟡</span>
            <div><strong>Turmeric / Curcumin</strong><span>Standardised 95% curcuminoids, organic certified, black pepper blend</span></div>
            <span class="ifw-pprod-tag ifw-tag-new">Organic</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🌾</span>
            <div><strong>Moringa &amp; Neem</strong><span>Powder, capsule, extract — India Organic &amp; USDA certified</span></div>
            <span class="ifw-pprod-tag">Herbal</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">💛</span>
            <div><strong>Herbal Oils &amp; Extracts</strong><span>Neem, Black Seed, Brahmi, Tulsi — cold-pressed &amp; steam-distilled</span></div>
            <span class="ifw-pprod-tag">Cold Pressed</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🧪</span>
            <div><strong>Custom Formulations</strong><span>OEM / private label Ayurvedic supplements in any format</span></div>
            <span class="ifw-pprod-tag ifw-tag-new">Private Label</span>
          </div>
        </div>
        <div class="ifw-ayur-visual">
          <img src="/images/products/supplements-flatlay.jpg" alt="Functional pet supplements and herbal ingredients including turmeric, omega-3, and natural treat varieties sourced from India" loading="lazy" />
          <div class="ifw-ayur-overlay">
            <span>USDA Organic · GMP · ISO 9001 · India Organic</span>
          </div>
        </div>
      </div>

      <p class="ifw-cat-footer">
        Don't see your product? If it's made in India, we can source it.
        <a href="#contact">Tell us what you need →</a>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       WHY INDIA — Visual Stats + Comparison Table
  ══════════════════════════════════════════════ -->
  <section class="ifw-section ifw-bg-dark" id="why-india">
    <div class="ifw-container">
      <div class="ifw-why-india-grid">
        <div class="ifw-why-india-left">
          <div class="ifw-eyebrow ifw-ey-light">Why Source from India</div>
          <h2 class="ifw-sh ifw-sh-light">India: The World's <em>Best-Kept</em> Sourcing Secret</h2>
          <p class="ifw-body-text ifw-text-muted-light">
            Savvy global brands are discovering that India's manufacturers produce world-class products at 30–50% less than Western equivalents — with an authentic natural ingredient story consumers love.
          </p>
          <div class="ifw-why-pts">
            <div class="ifw-why-pt">
              <div class="ifw-why-pt-icon">💰</div>
              <div>
                <h5>30–50% Lower Production Costs</h5>
                <p>Same or better quality. Your margins grow significantly without cutting corners on ingredients or processes.</p>
              </div>
            </div>
            <div class="ifw-why-pt">
              <div class="ifw-why-pt-icon">🌿</div>
              <div>
                <h5>Authentic Natural Ingredients</h5>
                <p>Neem, Ashwagandha, Turmeric, Hemp — grown organically in India for centuries. A genuine story consumers pay premium for.</p>
              </div>
            </div>
            <div class="ifw-why-pt">
              <div class="ifw-why-pt-icon">📋</div>
              <div>
                <h5>Full Certification Capability</h5>
                <p>GMP, USDA Organic, ISO 9001, FSSAI — all certifications your target market requires, available from our network.</p>
              </div>
            </div>
            <div class="ifw-why-pt">
              <div class="ifw-why-pt-icon">🏷️</div>
              <div>
                <h5>Private Label Expertise</h5>
                <p>Custom formulations, branding, and retail-ready packaging for global markets — your product, your brand, made in India.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="ifw-why-india-right">
          <div class="ifw-stats-mosaic">
            <div class="ifw-stat-tile ifw-stat-terra">
              <strong>30–50%</strong>
              <span>Lower production cost vs Western sources</span>
            </div>
            <div class="ifw-stat-tile ifw-stat-sage">
              <strong>$350B</strong>
              <span>Global pet market by 2027 — 12% annual growth</span>
            </div>
            <div class="ifw-stat-tile ifw-stat-parch">
              <strong>40%</strong>
              <span>Consumers actively prefer natural / herbal products</span>
            </div>
            <div class="ifw-stat-tile ifw-stat-deep">
              <strong>200+</strong>
              <span>Manufacturers in our personally vetted network</span>
            </div>
          </div>
          <div class="ifw-compare-box">
            <div class="ifw-compare-title">With Indofolk vs Going Alone</div>
            <div class="ifw-compare-scroll">
              <table class="ifw-compare-table">
                <thead>
                  <tr>
                    <th>What you need</th>
                    <th class="ifw-col-no">Going alone</th>
                    <th class="ifw-col-yes">With Indofolk</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>Vetted manufacturer list</td><td class="ifw-col-no">❌ Weeks of research</td><td class="ifw-col-yes">✅ 48 hours</td></tr>
                  <tr><td>Factory-direct pricing</td><td class="ifw-col-no">❌ Full retail quote</td><td class="ifw-col-yes">✅ 20–35% lower</td></tr>
                  <tr><td>Quality checks in India</td><td class="ifw-col-no">❌ Risk it</td><td class="ifw-col-yes">✅ Checked before shipment</td></tr>
                  <tr><td>Export documentation</td><td class="ifw-col-no">❌ Figure it out</td><td class="ifw-col-yes">✅ Fully handled</td></tr>
                  <tr><td>Language &amp; time zone</td><td class="ifw-col-no">❌ Your problem</td><td class="ifw-col-yes">✅ One point of contact</td></tr>
                  <tr><td>Private label &amp; packaging</td><td class="ifw-col-no">❌ Find vendors yourself</td><td class="ifw-col-yes">✅ End-to-end managed</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FACTORY STRIP
  ══════════════════════════════════════════════ -->
  <div class="ifw-factory-strip">
    <img src="/images/products/factory.jpg" alt="GMP-certified pet product manufacturing facility in India — branded pouches moving along a production line" loading="lazy" />
    <div class="ifw-factory-overlay">
      <div class="ifw-factory-content">
        <div class="ifw-eyebrow ifw-ey-light">Our Manufacturing Partners</div>
        <h3>GMP-Certified Factories.<br>Personally Audited. Globally Ready.</h3>
        <p>Every manufacturer in our network has been physically visited and audited by our team. No directory listings. No cold contacts. Only factories that consistently deliver.</p>
        <a href="#contact" class="ifw-btn-primary">See How We Vet Manufacturers →</a>
      </div>
      <div class="ifw-factory-badges">
        <div class="ifw-factory-badge">🏆 GMP Certified</div>
        <div class="ifw-factory-badge">🌱 USDA Organic</div>
        <div class="ifw-factory-badge">🔬 Lab Tested</div>
        <div class="ifw-factory-badge">📦 Export Ready</div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       PROCESS — 6 Steps
  ══════════════════════════════════════════════ -->
  <section class="ifw-section ifw-bg-cream" id="process">
    <div class="ifw-container">
      <div class="ifw-eyebrow">How We Work</div>
      <h2 class="ifw-sh">Six Steps. <em>Zero Stress.</em></h2>
      <p class="ifw-section-lead">From your first message to your warehouse — here's exactly what happens. No surprises, no ambiguity.</p>

      <div class="ifw-process-grid">
        <div class="ifw-proc-card">
          <div class="ifw-proc-num">01</div>
          <div class="ifw-proc-icon">📋</div>
          <h3>Understand Your Requirements</h3>
          <p>Product specs, target market, certifications needed, MOQ, budget, and timeline. We ask the questions most agencies skip.</p>
          <div class="ifw-proc-time">⏱ 30-minute briefing call</div>
        </div>
        <div class="ifw-proc-card">
          <div class="ifw-proc-num">02</div>
          <div class="ifw-proc-icon">🔍</div>
          <h3>Shortlist the Best Manufacturers</h3>
          <p>3–5 personally vetted factories matched to your brief. Certifications verified, facility audited, export track record confirmed.</p>
          <div class="ifw-proc-time">⏱ Shortlist within 48 hours</div>
        </div>
        <div class="ifw-proc-card">
          <div class="ifw-proc-num">03</div>
          <div class="ifw-proc-icon">🧪</div>
          <h3>Sampling &amp; Quality Checks</h3>
          <p>We coordinate sample production and check samples ourselves before dispatching to you. We iterate until it's exactly right.</p>
          <div class="ifw-proc-time">⏱ Samples in 2–4 weeks</div>
        </div>
        <div class="ifw-proc-card">
          <div class="ifw-proc-num">04</div>
