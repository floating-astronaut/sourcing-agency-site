---
import Base from '~/layouts/Base.astro';
import { site } from '~/lib/site';
---

<Base
  title="Your India Office for Pet & Ayurvedic Sourcing — IndoFolk Wellness"
  description="IndoFolk Wellness is the India office international brands wish they already had. We find, vet, and manage GMP-certified manufacturers for pet and Ayurvedic products — from first sample to your door."
>

  <!-- ══════════════════════════════════════════════════════════
       §1  HERO — One image. One identity. One invitation.
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-hero" id="main">
    <img
      src="/images/ifw/hero-factory-team.png"
      alt="IndoFolk Wellness team reviewing products with an international client inside a GMP-certified Indian factory"
      class="ifw-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="ifw-hero-grad" aria-hidden="true"></div>
    <div class="ifw-hero-inner">
      <div class="ifw-hero-content">
        <p class="ifw-hero-eyebrow">B2B Sourcing Agency &nbsp;·&nbsp; New Delhi, India</p>
        <h1 class="ifw-hero-h1">We're your<br>India office.</h1>
        <p class="ifw-hero-desc">
          We find the right manufacturers, inspect quality personally,
          and handle everything from first sample to your door —
          thinking like your team from inside the factories you can't visit.
        </p>
        <a href="#contact" class="ifw-hero-cta">
          Begin the conversation
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §2  STATEMENT — The identity, unadorned.
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-stmt ds-bg-white">
    <div class="ifw-stmt-inner">
      <p class="ifw-stmt-text" data-reveal>
        We are the India office<br>our clients wish they<br>already had.
      </p>
      <p class="ifw-stmt-sub" data-reveal data-delay="2">
        Not a vendor. Not a directory. A partner who thinks like your team —
        from inside the factories you cannot visit.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §3  SERVICES — What we do and why it matters
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-services ds-section ds-bg-cream">
    <div class="ds-container">
      <div class="ifw-services-grid">

        <div class="ifw-services-text">
          <span class="ds-eyebrow" data-reveal>What we do</span>
          <h2 class="ds-h2" data-reveal data-delay="1">Three ways<br>we work for you.</h2>

          <ol class="ifw-svc-list">
            <li class="ifw-svc-item" data-reveal data-delay="2">
              <span class="ifw-svc-num">01</span>
              <div>
                <h3 class="ifw-svc-name">Factory Matching</h3>
                <p class="ifw-svc-desc">We shortlist 3–5 GMP-certified manufacturers within 48 hours of your brief — factories we have personally visited and trust with our own reputation.</p>
              </div>
            </li>
            <li class="ifw-svc-item" data-reveal data-delay="3">
              <span class="ifw-svc-num">02</span>
              <div>
                <h3 class="ifw-svc-name">Quality &amp; Compliance</h3>
                <p class="ifw-svc-desc">We inspect on your behalf, verify every certification first-hand, manage sample rounds, and ensure products meet international export standards before anything leaves India.</p>
              </div>
            </li>
            <li class="ifw-svc-item" data-reveal data-delay="4">
              <span class="ifw-svc-num">03</span>
              <div>
                <h3 class="ifw-svc-name">Export &amp; Delivery</h3>
                <p class="ifw-svc-desc">We manage freight documentation, customs clearance, and full logistics — coordinating with your forwarder or handling it end-to-end, depending on your preference.</p>
              </div>
            </li>
          </ol>

          <a href="/contact" class="ds-text-cta" data-reveal data-delay="5">
            Tell us about your project
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="ifw-services-img" data-reveal data-delay="1">
          <img
            src="/images/ifw/factory-verification-1.png"
            alt="IndoFolk Wellness team members conducting quality inspection on the factory production line"
            class="ifw-services-photo"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §4  PET PRODUCTS — Photography grid
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-pet ds-section ds-bg-white">
    <div class="ds-container">

      <div class="ifw-pet-header">
        <div>
          <span class="ds-eyebrow" data-reveal>Pet Product Sourcing</span>
          <h2 class="ds-h2" data-reveal data-delay="1">From India's finest<br>factories to your shelf.</h2>
        </div>
        <a href="/pet-care-sourcing" class="ds-text-cta ifw-pet-header-cta" data-reveal data-delay="2" aria-label="Explore all pet products">
          Explore all products
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="ifw-pet-grid">
        {[
          { img: 'product-yak-cheese.png', name: 'Yak Cheese Chews', desc: 'High-protein, lactose-free, long-lasting' },
          { img: 'product-meat-fish.png',  name: 'Meat & Fish Treats', desc: 'Single-protein, freeze-dried & air-dried' },
          { img: 'product-supplements.png', name: 'Pet Supplements', desc: 'Joint, gut, skin & coat formulations' },
          { img: 'product-functional-treats.png', name: 'Functional Treats', desc: 'Calming, dental, hip & joint blends' },
          { img: 'product-freeze-dried.png', name: 'Freeze-Dried', desc: 'Complete meals & toppers, raw nutrition' },
          { img: 'closing-brand-products.png', name: 'Private Label', desc: 'Custom formulations, your branding' },
        ].map((p, i) => (
          <a href="/pet-care-sourcing" class="ifw-pet-card" data-reveal data-delay={String((i % 3) + 1)} aria-label={`Learn more about ${p.name}`}>
            <div class="ifw-pet-card-img-wrap">
              <img
                src={`/images/ifw/${p.img}`}
                alt={p.name}
                class="ifw-pet-card-img"
                loading="lazy"
              />
            </div>
            <div class="ifw-pet-card-body">
              <h3 class="ifw-pet-card-name">{p.name}</h3>
              <p class="ifw-pet-card-desc">{p.desc}</p>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §5  AYURVEDA — Editorial feature section
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-ayur ds-section ds-bg-subtle">
    <div class="ds-container">
      <div class="ifw-ayur-grid">

        <div class="ifw-ayur-img-wrap" data-reveal>
          <img
            src="/images/ifw/ayurveda-flatlay-2.png"
            alt="Premium Ayurvedic botanicals and extracts ready for international export"
            class="ifw-ayur-img"
            loading="lazy"
          />
        </div>

        <div class="ifw-ayur-text">
          <span class="ds-eyebrow" data-reveal>Ayurvedic Products</span>
          <h2 class="ds-h2" data-reveal data-delay="1">Pure Ayurveda.<br>Global standards.</h2>
          <p class="ds-body" data-reveal data-delay="2">
            India's Ayurvedic manufacturers are among the most regulated
            in the world. We connect you to suppliers with WHO-GMP
            certification, AYUSH licensing, and export credentials — for
            products that clear customs and meet your customers' expectations.
          </p>

          <ul class="ifw-ayur-list" data-reveal data-delay="3">
            <li>Ashwagandha &amp; Adaptogens</li>
            <li>Triphala &amp; Digestive Blends</li>
            <li>Brahmi &amp; Cognitive Herbs</li>
            <li>Turmeric Complex &amp; Anti-Inflammatories</li>
            <li>Neem, Moringa &amp; Superfoods</li>
            <li>Shilajit &amp; Mineral Extracts</li>
          </ul>

          <a href="/ayurveda-sourcing" class="ds-text-cta" data-reveal data-delay="4">
            Explore Ayurvedic sourcing
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §6  INDIA ADVANTAGE — Dark, map-centred
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-india ds-section-lg ds-bg-dark">
    <div class="ds-container">

      <div class="ifw-india-header">
        <span class="ds-eyebrow ds-eyebrow-light" data-reveal>Why India</span>
        <h2 class="ds-h2 ds-h2-light" data-reveal data-delay="1">
          India. Naturally advanced.<br>Globally connected.
        </h2>
        <p class="ds-body ds-body-light" data-reveal data-delay="2">
          No other country combines 5,000 years of botanical knowledge with
          modern GMP infrastructure and direct access to raw ingredients
          at their source. We are embedded here — so you don't have to be.
        </p>
      </div>

      <div class="ifw-india-map" data-reveal data-delay="2">
        <img
          src="/images/ifw/india-map-regional.png"
          alt="Regional India sourcing map — key manufacturing clusters for pet and Ayurvedic products"
          class="ifw-india-map-img"
          loading="lazy"
        />
      </div>

      <div class="ifw-india-stats" data-reveal data-delay="3">
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num">5,000+</span>
          <span class="ifw-india-stat-label">Years of Ayurvedic knowledge</span>
        </div>
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num">200+</span>
          <span class="ifw-india-stat-label">Vetted manufacturers in our network</span>
        </div>
        <div class="ifw-india-stat">
          <span class="ifw-india-stat-num">150+</span>
          <span class="ifw-india-stat-label">Export destination countries</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §7  FACTORY STRIP — Full-bleed evidence photo
       ══════════════════════════════════════════════════════════ -->
  <div class="ifw-strip">
    <img
      src="/images/ifw/factory-gmp-verified.png"
      alt="GMP-verified Indian factory production line — IndoFolk Wellness quality verification in action"
      class="ifw-strip-img"
      loading="lazy"
    />
  </div>

  <!-- ══════════════════════════════════════════════════════════
       §8  PROCESS — How we work
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-process ds-section ds-bg-white">
    <div class="ds-container">

      <div class="ifw-process-header">
        <span class="ds-eyebrow" data-reveal>How we work</span>
        <h2 class="ds-h2" data-reveal data-delay="1">Four steps from<br>brief to delivery.</h2>
      </div>

      <div class="ifw-process-grid">
        {[
          {
            n: '01',
            title: 'Brief us',
            body: 'Send us your product brief — category, certifications required, target MOQ, and your timeline. A 15-minute call is often all we need to understand your vision.',
            note: 'Typically: 15-min call',
          },
          {
            n: '02',
            title: 'Receive your shortlist',
            body: 'Within 48 hours, we send you 3–5 pre-vetted manufacturers with factory profiles, certifications, pricing ranges, and our personal recommendation.',
            note: 'Typically: 48 hours',
          },
          {
            n: '03',
            title: 'Approve your sample',
            body: 'We request samples, inspect them on your behalf, and manage any reformulation rounds until you are satisfied. Nothing proceeds without your sign-off.',
            note: 'Typically: 2–4 weeks',
          },
          {
            n: '04',
            title: 'Receive your delivery',
            body: 'We manage all production oversight, export documentation, and freight — delivering to your warehouse wherever you are in the world.',
            note: 'Typically: 6–10 weeks',
          },
        ].map((step, i) => (
          <div class="ifw-process-step" data-reveal data-delay={String(i + 1)}>
            <span class="ifw-process-num">{step.n}</span>
            <h3 class="ifw-process-title">{step.title}</h3>
            <p class="ifw-process-body">{step.body}</p>
            <span class="ifw-process-note">{step.note}</span>
          </div>
        ))}
      </div>

      <div class="ifw-process-cta" data-reveal>
        <a href={site.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Book a 30-minute call
        </a>
        <a href="/contact" class="ds-text-cta">
          Or send us a message
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §9  CLOSING — Cinematic final CTA
       ══════════════════════════════════════════════════════════ -->
  <section class="ifw-closing">
    <img
      src="/images/ifw/closing-port-figure.png"
      alt="A contemplative figure overlooking a shipping port at dusk — representing the bridge between India and global markets"
      class="ifw-closing-bg"
      loading="lazy"
    />
    <div class="ifw-closing-grad" aria-hidden="true"></div>
    <div class="ifw-closing-inner">
      <p class="ifw-closing-eyebrow" data-reveal>Ready to begin?</p>
      <h2 class="ifw-closing-h2" data-reveal data-delay="1">
        Begin the<br>conversation.
      </h2>
      <p class="ifw-closing-body" data-reveal data-delay="2">
        Whether you have a detailed brief or just a category in mind —
        we'll turn it into a sourcing plan within 24 hours.
      </p>
      <div class="ifw-closing-ctas" data-reveal data-delay="3">
        <a href={site.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Book a call
        </a>
        <a href={`mailto:${site.contactEmail}`} class="btn-ghost-light btn">
          Email us directly
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       §10 CONTACT — Founder + quick form
       ══════════════════════════════════════════════════════════ -->
  <section id="contact" class="ifw-contact ds-section ds-bg-cream">
    <div class="ds-container">
      <div class="ifw-contact-grid">

        <!-- Left: founder -->
        <div class="ifw-contact-founder" data-reveal>
          <div class="ifw-founder-img-wrap">
            <img
              src="/images/ifw/founder-divyanshu.png"
              alt="Divyanshu, Founder of IndoFolk Wellness, with his dogs"
              class="ifw-founder-img"
              loading="lazy"
            />
          </div>
          <div class="ifw-founder-bio">
            <p class="ifw-founder-name">Divyanshu</p>
            <p class="ifw-founder-role">Founder, IndoFolk Wellness</p>
            <p class="ifw-founder-note">
              "We built this agency because the India-to-global supply chain
              should feel like having someone trustworthy on the ground —
              not like navigating it blind."
            </p>
            <div class="ifw-founder-links">
              <a href={`mailto:${site.contactEmail}`} class="ds-text-cta">
                {site.contactEmail}
              </a>
              <a href={`tel:${site.phone.replace(/\s+/g,'')}`} class="ifw-founder-phone">
                {site.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="ifw-contact-form-wrap" data-reveal data-delay="2">
          <span class="ds-eyebrow">Get in touch</span>
          <h2 class="ds-h3" style="margin-bottom:1.8rem">Tell us about<br>your project.</h2>

          <form
            class="ifw-form"
            method="POST"
            action={`mailto:${site.contactEmail}`}
            enctype="text/plain"
          >
            <div class="ifw-form-row">
              <div class="ds-form-field">
                <label for="f-name" class="ds-form-label">Your name</label>
                <input id="f-name" name="name" type="text" class="ds-form-input" placeholder="Jane Smith" required />
              </div>
              <div class="ds-form-field">
                <label for="f-company" class="ds-form-label">Company / Brand</label>
                <input id="f-company" name="company" type="text" class="ds-form-input" placeholder="Acme Pet Co." required />
              </div>
            </div>

            <div class="ifw-form-row">
              <div class="ds-form-field">
                <label for="f-email" class="ds-form-label">Email address</label>
                <input id="f-email" name="email" type="email" class="ds-form-input" placeholder="jane@brand.com" required />
              </div>
              <div class="ds-form-field">
                <label for="f-country" class="ds-form-label">Country</label>
                <input id="f-country" name="country" type="text" class="ds-form-input" placeholder="United States" />
              </div>
            </div>

            <div class="ds-form-field">
              <label for="f-category" class="ds-form-label">Product category</label>
              <select id="f-category" name="category" class="ds-form-input">
                <option value="">Select category…</option>
                <option>Pet Care</option>
                <option>Ayurveda / Wellness</option>
                <option>Both</option>
                <option>Other</option>
              </select>
            </div>

            <div class="ds-form-field">
              <label for="f-message" class="ds-form-label">Tell us about your project</label>
              <textarea id="f-message" name="message" class="ds-form-input ds-form-textarea" placeholder="Product category, target market, MOQ, certifications needed…" rows="4"></textarea>
            </div>

            <button type="submit" class="ds-submit">Send message</button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Base>

<style is:global>

/* ═══════════════════════════════════════════════════════════
   HOMEPAGE — ifw- scoped styles
   ═══════════════════════════════════════════════════════════ */

/* ── §1 Hero ─────────────────────────────────────────────── */
.ifw-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #141E16;
}
.ifw-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 28%;
  animation: heroBreath 12s ease-out both;
}
@keyframes heroBreath {
  from { transform: scale(1.04); }
  to   { transform: scale(1.00); }
}
@media (prefers-reduced-motion: reduce) { .ifw-hero-bg { animation: none; } }
.ifw-hero-grad {
  position: absolute; inset: 0;
  background: linear-gradient(
    108deg,
    rgba(20,30,22,0.94) 0%,
    rgba(20,30,22,0.78) 36%,
    rgba(20,30,22,0.42) 58%,
    rgba(20,30,22,0.08) 100%
  );
}
.ifw-hero-inner {
  position: relative; z-index: 2;
  max-width: 1180px; margin: 0 auto;
  padding: 9rem 5% 7rem; width: 100%;
}
.ifw-hero-content { max-width: 510px; }
.ifw-hero-eyebrow {
  font-size: 0.67rem; font-weight: 600;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(250,248,244,0.40);
  margin-bottom: 1.8rem; margin-top: 0;
}
.ifw-hero-h1 {
  font-size: clamp(3.4rem, 6.5vw, 5.4rem); font-weight: 800;
  line-height: 1.0; letter-spacing: -0.036em;
  color: #FAF8F4; margin: 0 0 1.6rem;
}
.ifw-hero-desc {
  font-size: 1.0rem; line-height: 1.9;
  color: rgba(250,248,244,0.56);
  max-width: 390px; margin: 0 0 2.4rem;
}
.ifw-hero-cta {
  display: inline-flex; align-items: center; gap: 8px;
  color: #FAF8F4; font-size: 0.88rem; font-weight: 600;
  letter-spacing: 0.01em; text-decoration: none;
  padding-bottom: 3px; border-bottom: 1px solid rgba(250,248,244,0.28);
  transition: color 0.28s, border-color 0.28s;
}
.ifw-hero-cta:hover { color: #B8960C; border-color: #B8960C; }
.ifw-hero-cta svg { transition: transform 0.28s; flex-shrink: 0; }
.ifw-hero-cta:hover svg { transform: translateX(4px); }
@media (max-width: 640px) {
  .ifw-hero-inner { padding: 7rem 6% 5rem; }
  .ifw-hero-h1 { font-size: clamp(3rem, 11vw, 4rem); }
  .ifw-hero-desc { max-width: 100%; }
  .ifw-hero-grad { background: linear-gradient(180deg,rgba(20,30,22,0.88) 0%,rgba(20,30,22,0.70) 100%); }
  .ifw-hero-bg { object-position: 60% 28%; }
  .ifw-closing-bg { object-position: center center; }
}

/* ── §2 Statement ────────────────────────────────────────── */
.ifw-stmt {
  padding: 8rem 5%;
  border-bottom: 1px solid #DCD5C9;
}
.ifw-stmt-inner {
  max-width: 1180px; margin: 0 auto;
}
.ifw-stmt-text {
  font-size: clamp(2.6rem, 5vw, 4.4rem);
  font-weight: 800; line-height: 1.07;
  letter-spacing: -0.033em;
  color: #1C1814;
  max-width: 720px; margin: 0 0 2rem;
}
.ifw-stmt-sub {
  font-size: 1.05rem; line-height: 1.85;
  color: #6B6358; max-width: 520px;
}
@media (max-width: 640px) {
  .ifw-stmt { padding: 5rem 5%; }
  .ifw-stmt-text { font-size: clamp(2rem, 9vw, 3rem); }
}

/* ── §3 Services ─────────────────────────────────────────── */
.ifw-services-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 5rem;
  align-items: start;
}
.ifw-services-text .ds-h2 { margin: 0 0 2.8rem; }
.ifw-svc-list {
  list-style: none; padding: 0; margin: 0 0 2.5rem;
  display: flex; flex-direction: column; gap: 2.2rem;
}
.ifw-svc-item {
  display: grid;
  grid-template-columns: 2.8rem 1fr;
  gap: 0.5rem;
  align-items: start;
  padding-top: 1.4rem;
  border-top: 1px solid #DCD5C9;
}
.ifw-svc-num {
  font-size: 0.67rem; font-weight: 700;
  letter-spacing: 0.06em;
  color: #B8960C;
