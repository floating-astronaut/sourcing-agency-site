---
import Base from '~/layouts/Base.astro';
import { site } from '~/lib/site';
---

<Base
  title="India's #1 B2B Sourcing Agency for Pet & Ayurvedic Products"
  description="IndoFolk Wellness connects global brands to GMP-certified Indian manufacturers for pet treats, supplements, and Ayurvedic products. Factory matching in 48 hours. Free consultation."
>

  <!-- ══ HERO ══════════════════════════════════════════════ -->
  <section class="ifw-hero">
    <div class="ifw-glow ifw-glow-1"></div>
    <div class="ifw-glow ifw-glow-2"></div>
    <div class="ifw-hero-inner">
      <div class="ifw-hero-left">
        <div class="ifw-badge">
          <span class="ifw-badge-pulse"></span>
          B2B Sourcing Agency &nbsp;·&nbsp; New Delhi, India
        </div>
        <h1 class="ifw-h1">Source from India's <em>finest manufacturers.</em></h1>
        <p class="ifw-hero-lead">
          We find, vet, and manage Indian factories for pet &amp; Ayurvedic products — from first sample to your warehouse door.
        </p>
        <div class="ifw-hero-ctas">
          <a href={site.calendlyUrl} target="_blank" rel="noopener" class="ifw-cta-primary">Book Free Consultation</a>
          <a href="#products" class="ifw-cta-ghost">View Products ↓</a>
        </div>
        <div class="ifw-hero-stats">
          <div class="ifw-hstat">
            <strong class="ifw-hstat-num">200+</strong>
            <span>Vetted factories</span>
          </div>
          <div class="ifw-hstat-sep"></div>
          <div class="ifw-hstat">
            <strong class="ifw-hstat-num">48h</strong>
            <span>Manufacturer shortlist</span>
          </div>
          <div class="ifw-hstat-sep"></div>
          <div class="ifw-hstat">
            <strong class="ifw-hstat-num">15+</strong>
            <span>Export markets</span>
          </div>
          <div class="ifw-hstat-sep"></div>
          <div class="ifw-hstat">
            <strong class="ifw-hstat-num">1–2%</strong>
            <span>Transparent fee</span>
          </div>
        </div>
      </div>
      <div class="ifw-hero-right">
        <div class="ifw-mosaic">
          <img src="/images/products/yak-cheese-branded.jpg" class="ifw-mp ifw-mp-main"
            alt="Himalayan Yak Cheese Dog Chews — private label ready, sourced from India" loading="eager" />
          <div class="ifw-mosaic-col">
            <img src="/images/products/factory.jpg" class="ifw-mp"
              alt="GMP-certified manufacturing facility in India" loading="eager" />
            <img src="/images/products/treats-pouches.jpg" class="ifw-mp"
              alt="Custom private label pet treat pouches manufactured in India" loading="eager" />
          </div>
          <div class="ifw-mosaic-float">
            <div class="ifw-mf-num">1–2%</div>
            <div class="ifw-mf-label">Fee. Savings<br>cover it.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MARQUEE ═══════════════════════════════════════════ -->
  <div class="ifw-marquee" aria-hidden="true">
    <div class="ifw-marquee-track">
      <span>GMP Certified</span><span class="ifw-mx">·</span>
      <span>FSSAI Licensed</span><span class="ifw-mx">·</span>
      <span>USDA Organic</span><span class="ifw-mx">·</span>
      <span>ISO 9001</span><span class="ifw-mx">·</span>
      <span>HACCP</span><span class="ifw-mx">·</span>
      <span>APEDA Export</span><span class="ifw-mx">·</span>
      <span>India Organic</span><span class="ifw-mx">·</span>
      <span>Halal Certified</span><span class="ifw-mx">·</span>
      <span>Lab Tested</span><span class="ifw-mx">·</span>
      <span>Private Label</span><span class="ifw-mx">·</span>
      <span>200+ Factories</span><span class="ifw-mx">·</span>
      <span>15+ Markets</span><span class="ifw-mx">·</span>
      <span>48h Shortlist</span><span class="ifw-mx">·</span>
      <span>GMP Certified</span><span class="ifw-mx">·</span>
      <span>FSSAI Licensed</span><span class="ifw-mx">·</span>
      <span>USDA Organic</span><span class="ifw-mx">·</span>
      <span>ISO 9001</span><span class="ifw-mx">·</span>
      <span>HACCP</span><span class="ifw-mx">·</span>
      <span>APEDA Export</span><span class="ifw-mx">·</span>
      <span>India Organic</span><span class="ifw-mx">·</span>
      <span>Halal Certified</span><span class="ifw-mx">·</span>
      <span>Lab Tested</span><span class="ifw-mx">·</span>
      <span>Private Label</span><span class="ifw-mx">·</span>
      <span>200+ Factories</span><span class="ifw-mx">·</span>
      <span>15+ Markets</span><span class="ifw-mx">·</span>
      <span>48h Shortlist</span><span class="ifw-mx">·</span>
    </div>
  </div>

  <!-- ══ SERVICES — 3 Pillars ══════════════════════════════ -->
  <section class="ifw-section ifw-white" id="about">
    <div class="ifw-container">
      <div class="ifw-section-head ifw-centered" data-reveal>
        <div class="ifw-eyebrow">End-to-End Service</div>
        <h2 class="ifw-sh">Everything between inquiry<br>and delivery. <em>Handled.</em></h2>
      </div>
      <div class="ifw-pillars">
        <div class="ifw-pillar" data-reveal data-delay="0">
          <div class="ifw-pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <h3>Factory Matching</h3>
          <p>We shortlist 3–5 personally audited manufacturers within 48 hours — matched to your product, certifications, and budget. No cold contacts. Only factories we know.</p>
        </div>
        <div class="ifw-pillar" data-reveal data-delay="100">
          <div class="ifw-pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3>Quality &amp; Compliance</h3>
          <p>We audit factories, check samples, run lab tests, and verify every certification — so your product is compliant and consistent before it ever leaves India.</p>
        </div>
        <div class="ifw-pillar" data-reveal data-delay="200">
          <div class="ifw-pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <h3>Export &amp; Delivery</h3>
          <p>Freight coordination, customs documentation, and full compliance support for your destination market. Door-to-door delivery to 15+ countries worldwide.</p>
        </div>
      </div>
      <div class="ifw-pillars-cta" data-reveal>
        <a href="#contact" class="ifw-btn-brand">Tell Us What You Need →</a>
      </div>
    </div>
  </section>

  <!-- ══ PRODUCTS ══════════════════════════════════════════ -->
  <section class="ifw-section ifw-subtle" id="products">
    <div class="ifw-container">
      <div class="ifw-section-head" data-reveal>
        <div class="ifw-eyebrow">What We Source</div>
        <h2 class="ifw-sh">Two specialisations. <em>One expert partner.</em></h2>
      </div>

      <div class="ifw-cat-sub" data-reveal>
        <span class="ifw-cat-pill ifw-pill-blue">🐾 Pet Products</span>
        <span class="ifw-cat-note">India's fastest-growing export category</span>
        <a href="/pet-care-sourcing" class="ifw-cat-link">Explore pet sourcing →</a>
      </div>

      <div class="ifw-prod-grid">
        <div class="ifw-prod-card" data-reveal data-delay="0">
          <div class="ifw-prod-img">
            <img src="/images/products/yak-cheese-branded.jpg"
              alt="Himalayan Yak Cheese Dog Chews — branded packaging, private label ready" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-hot">#1 Seller</span>
            <span class="ifw-prod-pl">Private Label</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Yak Cheese Chews</h4>
            <p>100% natural Himalayan yak milk — lactose-free, long-lasting, high-protein. Bestseller in US &amp; UK markets.</p>
            <div class="ifw-prod-tags"><span>Natural</span><span>Lactose-Free</span><span>Human-Grade</span></div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card" data-reveal data-delay="75">
          <div class="ifw-prod-img">
            <img src="/images/products/treats-pouches.jpg"
              alt="Chicken jerky and fish treats in custom private label pouches" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-demand">High Demand</span>
            <span class="ifw-prod-pl">Private Label</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Meat &amp; Fish Treats</h4>
            <p>Chicken jerky, fish skins, salmon strips — single-ingredient, air-dried, human-grade. In your brand's packaging.</p>
            <div class="ifw-prod-tags"><span>Single Ingredient</span><span>Air-Dried</span><span>Human-Grade</span></div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card" data-reveal data-delay="150">
          <div class="ifw-prod-img">
            <img src="/images/products/pet-supplements.jpg"
              alt="Pet supplement range — Hip and Joint, Omega-3, Probiotic, Digestive Enzymes" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-pl">Custom Formula</span>
            <span class="ifw-prod-pl">Private Label</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Pet Supplements</h4>
            <p>Hip &amp; Joint, Omega-3, Digestive Enzymes, Probiotic, Multivitamin — vet-formulated, in your brand.</p>
            <div class="ifw-prod-tags"><span>Vet-Formulated</span><span>Tablet/Capsule</span><span>Custom SKUs</span></div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card" data-reveal data-delay="225">
          <div class="ifw-prod-img">
            <img src="/images/products/functional-treats.jpg"
              alt="Functional dog treats and biscuits with turmeric, omega-3 and natural ingredients" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-hot">Herbal Formula</span>
            <span class="ifw-prod-pl">Private Label</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Functional Treats</h4>
            <p>Soft chews &amp; biscuits with Glucosamine, Turmeric, Omega-3. Treats with purpose — joint, calming, immunity.</p>
            <div class="ifw-prod-tags"><span>Soft Chew</span><span>Herbal</span><span>Joint Health</span></div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card" data-reveal data-delay="300">
          <div class="ifw-prod-img">
            <img src="/images/products/freeze-dried.jpg"
              alt="Freeze-dried pet treats — chicken cubes, salmon pieces and dried fish" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-new">Trending</span>
            <span class="ifw-prod-pl">Private Label</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Freeze-Dried Treats</h4>
            <p>Freeze-dried chicken, salmon, fish — raw nutrition, clean label. Premium positioning for upscale brands.</p>
            <div class="ifw-prod-tags"><span>Raw Nutrition</span><span>Clean Label</span><span>Premium</span></div>
            <a href="#contact" class="ifw-prod-cta">Source This →</a>
          </div>
        </div>

        <div class="ifw-prod-card" data-reveal data-delay="375">
          <div class="ifw-prod-img">
            <img src="/images/products/private-label.jpg"
              alt="Private label pet product packaging range — custom pouches, jars and boxes" loading="lazy" />
            <span class="ifw-prod-badge ifw-badge-pl">Your Brand</span>
            <span class="ifw-prod-pl">All Categories</span>
          </div>
          <div class="ifw-prod-body">
            <h4>Private Label Ready</h4>
            <p>Every product under your brand — custom packaging, OEM formulations, retail-ready from GMP-certified factories.</p>
            <div class="ifw-prod-tags"><span>Custom Packaging</span><span>OEM</span><span>GMP Certified</span></div>
            <a href="#contact" class="ifw-prod-cta">Get Started →</a>
          </div>
        </div>
      </div>

      <!-- Ayurvedic -->
      <div class="ifw-cat-sub" style="margin-top:4rem" data-reveal>
        <span class="ifw-cat-pill ifw-pill-green">🌿 Ayurvedic Products</span>
        <span class="ifw-cat-note">Certified organic herbs, oils &amp; formulations</span>
        <a href="/ayurveda-sourcing" class="ifw-cat-link">Explore Ayurveda sourcing →</a>
      </div>

      <div class="ifw-ayur-grid">
        <div class="ifw-ayur-visual" data-reveal>
          <img src="/images/products/supplements-flatlay.jpg"
            alt="Ayurvedic supplement ingredients and finished products sourced from India" loading="lazy" />
          <div class="ifw-ayur-overlay">USDA Organic · GMP · ISO 9001 · India Organic</div>
        </div>
        <div class="ifw-ayur-items" data-reveal data-delay="150">
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🪨</span>
            <div><strong>Shilajit</strong><span>Resin, powder, capsule — lab-verified purity, fulvic acid certified</span></div>
            <span class="ifw-ayur-tag ifw-tag-premium">Premium</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🌱</span>
            <div><strong>Ashwagandha</strong><span>USDA Organic, KSM-66 &amp; Sensoril certified, root extract</span></div>
            <span class="ifw-ayur-tag ifw-tag-hot">Best Seller</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🟡</span>
            <div><strong>Turmeric / Curcumin</strong><span>95% curcuminoids standardised, organic certified, black pepper blend</span></div>
            <span class="ifw-ayur-tag ifw-tag-organic">Organic</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🌾</span>
            <div><strong>Moringa &amp; Neem</strong><span>Powder, capsule, extract — India Organic &amp; USDA certified</span></div>
            <span class="ifw-ayur-tag">Herbal</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">💛</span>
            <div><strong>Herbal Oils &amp; Extracts</strong><span>Neem, Black Seed, Brahmi, Tulsi — cold-pressed &amp; steam-distilled</span></div>
            <span class="ifw-ayur-tag">Cold Pressed</span>
          </div>
          <div class="ifw-ayur-item">
            <span class="ifw-ayur-icon">🧪</span>
            <div><strong>Custom Formulations</strong><span>OEM / private label Ayurvedic supplements in any delivery format</span></div>
            <span class="ifw-ayur-tag ifw-tag-organic">Private Label</span>
          </div>
        </div>
      </div>
      <p class="ifw-cat-footer" data-reveal>
        Don't see your product? If it's made in India, we can source it.
        <a href="#contact">Tell us what you need →</a>
      </p>
    </div>
  </section>

  <!-- ══ WHY INDIA — Dark stats ════════════════════════════ -->
  <section class="ifw-section ifw-dark" id="why-india">
    <div class="ifw-container">
      <div class="ifw-section-head ifw-centered" data-reveal>
        <div class="ifw-eyebrow ifw-ey-light">Why Source From India</div>
        <h2 class="ifw-sh ifw-sh-light">India gives you an<br><em>unfair competitive advantage.</em></h2>
      </div>
      <div class="ifw-india-stats" data-reveal>
        <div class="ifw-istat">
          <strong class="ifw-istat-num">30–50%</strong>
          <span class="ifw-istat-label">Cost savings vs. Western sourcing</span>
        </div>
        <div class="ifw-istat-sep"></div>
        <div class="ifw-istat">
          <strong class="ifw-istat-num">$350B</strong>
          <span class="ifw-istat-label">Global pet market by 2027</span>
        </div>
        <div class="ifw-istat-sep"></div>
        <div class="ifw-istat">
          <strong class="ifw-istat-num">200+</strong>
          <span class="ifw-istat-label">Vetted factories in our network</span>
        </div>
        <div class="ifw-istat-sep"></div>
        <div class="ifw-istat">
          <strong class="ifw-istat-num">5,000</strong>
          <span class="ifw-istat-label">Years of Ayurvedic tradition</span>
        </div>
      </div>
      <div class="ifw-india-pts" data-reveal data-delay="150">
        <div class="ifw-india-pt">
          <div class="ifw-india-pt-icon">💰</div>
          <div>
            <h5>Radically lower production costs</h5>
            <p>Same or better quality. 30–50% less than Western equivalents. Your margins grow without cutting corners on ingredients or processes.</p>
          </div>
        </div>
        <div class="ifw-india-pt">
          <div class="ifw-india-pt-icon">🌿</div>
          <div>
            <h5>Authentic natural ingredients</h5>
            <p>Ashwagandha, Turmeric, Neem — grown organically in India for centuries. A genuine provenance story consumers pay premium for.</p>
          </div>
        </div>
        <div class="ifw-india-pt">
          <div class="ifw-india-pt-icon">🏆</div>
          <div>
            <h5>Full certification capability</h5>
            <p>GMP, USDA Organic, ISO 9001, FSSAI — all certifications your target market requires, available from our vetted network.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FACTORY STRIP — Cinematic ═════════════════════════ -->
  <div class="ifw-factory">
    <img src="/images/products/factory.jpg"
      alt="GMP-certified manufacturing facility — IndoFolk Wellness partner factory in India" loading="lazy" />
    <div class="ifw-factory-overlay">
      <div class="ifw-factory-content">
        <h3>Personally audited.<br>GMP-certified.<br>Export-ready.</h3>
        <a href="#contact" class="ifw-factory-cta">Enquire Now →</a>
        <div class="ifw-factory-chips">
          <span>GMP</span><span>USDA Organic</span><span>Lab Tested</span><span>Export Ready</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ PROCESS — Horizontal timeline ═════════════════════ -->
  <section class="ifw-section ifw-white" id="process">
    <div class="ifw-container">
      <div class="ifw-section-head ifw-centered" data-reveal>
        <div class="ifw-eyebrow">How We Work</div>
        <h2 class="ifw-sh">From inquiry to delivery.<br><em>Four clear steps.</em></h2>
      </div>
      <div class="ifw-timeline" data-reveal>
        <div class="ifw-tl-track">
          <div class="ifw-tl-progress" id="tlProgress"></div>
        </div>
        <div class="ifw-tl-steps">
          <div class="ifw-tl-step">
            <div class="ifw-tl-node">01</div>
            <h4>Brief</h4>
            <p>30-min call. We learn your product, market, certifications needed, and budget.</p>
            <span class="ifw-tl-time">30-min call</span>
          </div>
          <div class="ifw-tl-step">
            <div class="ifw-tl-node">02</div>
            <h4>Shortlist</h4>
            <p>3–5 audited factories delivered. Certifications verified. Best price negotiated.</p>
            <span class="ifw-tl-time">Within 48 hours</span>
          </div>
          <div class="ifw-tl-step">
            <div class="ifw-tl-node">03</div>
            <h4>Sample</h4>
            <p>We check samples ourselves before you see them. Iterate until it's exactly right.</p>
            <span class="ifw-tl-time">2–4 weeks</span>
          </div>
          <div class="ifw-tl-step">
            <div class="ifw-tl-node">04</div>
            <h4>Deliver</h4>
            <p>Production supervised. All export docs handled. Door-to-door, worldwide.</p>
            <span class="ifw-tl-time">Door-to-door</span>
          </div>
        </div>
      </div>
      <div class="ifw-process-cta" data-reveal>
        <a href={site.calendlyUrl} target="_blank" rel="noopener" class="ifw-btn-brand">Book a Free 30-Min Call →</a>
        <span>No commitment. Just clarity.</span>
      </div>
    </div>
  </section>

  <!-- ══ CERTIFICATIONS ════════════════════════════════════ -->
  <section class="ifw-section ifw-subtle">
    <div class="ifw-container">
      <div class="ifw-section-head ifw-centered" data-reveal>
        <div class="ifw-eyebrow">Compliance &amp; Certifications</div>
        <h2 class="ifw-sh">Your product. <em>Fully certified.</em></h2>
      </div>
      <div class="ifw-cert-strip" data-reveal>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">🏆</span>GMP Certified</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">🌱</span>USDA Organic</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">🔬</span>FSSAI Licensed</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">📋</span>ISO 9001</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">✅</span>HACCP</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">📦</span>APEDA</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">🍃</span>India Organic</div>
        <div class="ifw-cert-pill"><span class="ifw-cp-icon">☪️</span>Halal</div>
      </div>
      <p class="ifw-cert-note" data-reveal>Full compliance documentation provided with every shipment.<br>We handle the paperwork — you focus on growing your brand.</p>
    </div>
  </section>

  <!-- ══ TESTIMONIALS — Editorial ══════════════════════════ -->
  <section class="ifw-section ifw-dark" id="why-us">
    <div class="ifw-container">
      <div class="ifw-section-head ifw-centered" data-reveal>
        <div class="ifw-eyebrow ifw-ey-light">Client Stories</div>
        <h2 class="ifw-sh ifw-sh-light">Brands that <em>trust us.</em></h2>
      </div>
      <div class="ifw-testi-featured" data-reveal>
        <div class="ifw-testi-qmark">"</div>
        <blockquote class="ifw-testi-quote">
          Indofolk completely changed how we source from India. They found a manufacturer we never would have discovered — GMP certified, export-ready, and 28% cheaper than our previous supplier. Every step was handled for us.
        </blockquote>
        <div class="ifw-testi-attr">
          <div class="ifw-testi-avatar">S</div>
          <div>
            <strong>Sarah Mitchell</strong>
            <span>Founder, PawNatural Co. — United States 🇺🇸</span>
          </div>
          <div class="ifw-testi-stars">★★★★★</div>
        </div>
      </div>
      <div class="ifw-testi-secondary">
        <div class="ifw-testi-card" data-reveal>
          <p>"We were nervous about sourcing from India for the first time. Indofolk held our hand through every step — sampling, negotiation, customs paperwork. Feels like having a real team in India."</p>
          <div class="ifw-testi-attr">
            <div class="ifw-testi-avatar">J</div>
            <div>
              <strong>James Thornton</strong>
              <span>Head of Procurement, GreenPaws UK 🇬🇧</span>
            </div>
          </div>
        </div>
        <div class="ifw-testi-card" data-reveal data-delay="150">
          <p>"We needed certified organic Ashwagandha fast. Indofolk came back with three options in 48 hours — all USDA certified, all export-ready. Outstanding quality, unbeatable pricing."</p>
          <div class="ifw-testi-attr">
            <div class="ifw-testi-avatar">F</div>
            <div>
              <strong>Fatima Al-Rashid</strong>
              <span>Co-founder, Natura Wellness — UAE 🇦🇪</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ════════════════════════════════════════════════ -->
  <section class="ifw-section ifw-subtle" id="faq">
    <div class="ifw-container">
      <div class="ifw-faq-layout">
        <div class="ifw-faq-left" data-reveal>
          <div class="ifw-eyebrow">FAQ</div>
          <h2 class="ifw-sh" style="font-size:2.2rem">Everything<br>you want<br>to know.</h2>
          <p class="ifw-body-text" style="margin-top:1rem">Can't find your answer? We reply within 24 hours.</p>
          <a href="#contact" class="ifw-faq-link">Ask us directly →</a>
        </div>
        <div class="ifw-faq-list" id="faqList" data-reveal data-delay="150">
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">What exactly does a sourcing agency do?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">We act as your procurement partner in India. We identify manufacturers, negotiate prices, manage quality control, coordinate production, and handle logistics — so you don't have to navigate Indian supply chains alone. Think of us as your India office.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">What does Indofolk Wellness charge?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">We charge a small service fee of 1–2% of the total order value. We also earn a 5–10% commission from the manufacturer. Our negotiation savings typically cover our fee several times over.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">What is the minimum order quantity?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">It varies by product and manufacturer. We work with brands at every stage — from D2C startups placing their first test order to large-scale importers. Tell us your requirement and we'll find a manufacturer that fits.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">How long does the entire process take?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">You'll have your first manufacturer shortlist within 48 hours. Sampling takes 2–4 weeks. Production and delivery timelines depend on the product and destination — we provide a full timeline upfront and keep you updated at every milestone.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">Which countries do you export to?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">USA, UAE, UK, Germany, Australia, Canada, and 15+ other countries. We handle all export documentation, customs paperwork, and import compliance requirements for your destination market.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">What certifications do your manufacturers hold?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">GMP, USDA Organic, India Organic, FSSAI, ISO 9001, Halal, Kosher, and others depending on the category. We match you to manufacturers with the specific certifications your market requires.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">Can you do private label and custom formulations?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">Absolutely — private label is one of our most popular services. Custom formulations, branding, and custom packaging — your product, your brand, made in India.</div>
          </div>
          <div class="ifw-faq-item">
            <button class="ifw-faq-q" aria-expanded="false">How do you ensure product quality?<span class="ifw-faq-icon">+</span></button>
            <div class="ifw-faq-a">We check samples ourselves before they reach you. During production, we conduct in-process quality audits. We verify all certifications and compliance documents. We are your quality control team in India.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CONTACT ════════════════════════════════════════════ -->
  <section class="ifw-section ifw-dark" id="contact">
    <div class="ifw-container">
      <div class="ifw-contact-grid">
        <div class="ifw-contact-left" data-reveal>
          <div class="ifw-eyebrow ifw-ey-light">Ready to Start?</div>
          <h2 class="ifw-sh ifw-sh-light">Tell us what you need.<br><em>We'll handle the rest.</em></h2>
          <p class="ifw-contact-lead">
            Free consultation. No commitment until you approve a quote. We reply within 24 hours with manufacturer options and clear next steps.
          </p>
          <div class="ifw-contact-checks">
            <div class="ifw-ccheck">Free initial sourcing consultation</div>
            <div class="ifw-ccheck">Manufacturer shortlist within 48 hours</div>
            <div class="ifw-ccheck">No obligation until you approve a quote</div>
            <div class="ifw-ccheck">Private label &amp; custom formulation supported</div>
          </div>
          <div class="ifw-calendly-block">
            <p class="ifw-cal-title">Prefer to talk first?</p>
            <a href={site.calendlyUrl} target="_blank" rel="noopener" class="ifw-cal-btn">
              📅 Book a 30-Min Call (Free)
            </a>
            <p class="ifw-cal-sub">Pick a time that works — we'll come prepared.</p>
          </div>
          <div class="ifw-contact-direct">
            <a href="https://wa.me/919971318109" target="_blank" rel="noopener" class="ifw-wa-btn">💬 WhatsApp: +91 99713 18109</a>
            <a href={`mailto:${site.contactEmail}`} class="ifw-email-btn">✉️ {site.contactEmail}</a>
          </div>
        </div>

        <div class="ifw-contact-right" data-reveal data-delay="150">
          <div class="ifw-form-card">
            <h3 class="ifw-form-title">Post Your Sourcing Inquiry</h3>
            <p class="ifw-form-sub">Fill in what you can — we'll reach out within 24 hours.</p>
            <form id="sourcingForm" class="ifw-form" method="POST" action="/thanks"
              data-netlify="true" name="sourcing-inquiry">
              <input type="hidden" name="form-name" value="sourcing-inquiry" />
              <div class="ifw-form-row">
                <div class="ifw-form-group">
                  <label for="f-name">Your Name <span class="ifw-req">*</span></label>
                  <input type="text" id="f-name" name="name" required placeholder="Jane Smith" class="ifw-input" />
                </div>
                <div class="ifw-form-group">
                  <label for="f-company">Company Name</label>
                  <input type="text" id="f-company" name="company" placeholder="Your Brand Ltd." class="ifw-input" />
                </div>
              </div>
              <div class="ifw-form-row">
                <div class="ifw-form-group">
                  <label for="f-email">Business Email <span class="ifw-req">*</span></label>
                  <input type="email" id="f-email" name="email" required placeholder="jane@yourbrand.com" class="ifw-input" />
                </div>
                <div class="ifw-form-group">
                  <label for="f-phone">Mobile / WhatsApp</label>
                  <input type="tel" id="f-phone" name="phone" placeholder="+1 555 000 0000" class="ifw-input" />
                </div>
              </div>
              <div class="ifw-form-row">
                <div class="ifw-form-group">
                  <label for="f-country">Country / Target Market <span class="ifw-req">*</span></label>
                  <input type="text" id="f-country" name="country" required placeholder="USA, UK, UAE…" class="ifw-input" />
                </div>
                <div class="ifw-form-group">
                  <label for="f-website">Company Website</label>
                  <input type="url" id="f-website" name="website" placeholder="https://yourbrand.com" class="ifw-input" />
                </div>
              </div>
              <div class="ifw-form-group">
                <label for="f-category">I'm interested in</label>
                <select id="f-category" name="category" class="ifw-input">
                  <option value="">Select a category…</option>
                  <option>Pet Products (Treats, Supplements, Grooming)</option>
                  <option>Ayurvedic Products (Herbs, Oils, Supplements)</option>
                  <option>Both Pet &amp; Ayurvedic</option>
                  <option>Other / Not sure yet</option>
                </select>
              </div>
              <div class="ifw-form-group">
                <label for="f-requirement">What are you looking to source? <span class="ifw-req">*</span></label>
                <textarea id="f-requirement" name="requirement" required rows="4"
                  placeholder="E.g. Yak Cheese Chews — natural, USDA certified, private label, shipping to USA. MOQ ~500 units."
                  class="ifw-input ifw-textarea"></textarea>
              </div>
              <button type="submit" class="ifw-submit-btn">Send My Sourcing Inquiry →</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<style is:global>
  /* ── Layout ── */
  .ifw-container { max-width: 1180px; margin: 0 auto; padding: 0 5%; }
  .ifw-section   { padding: 6rem 5%; position: relative; }
  .ifw-white     { background: #ffffff; }
  .ifw-subtle    { background: #f8fafc; }
  .ifw-dark      { background: #040d1f; overflow: hidden; }
  .ifw-section-head { margin-bottom: 3rem; }
  .ifw-section-head.ifw-centered { text-align: center; display: flex; flex-direction: column; align-items: center; }

  /* ── Scroll reveal ── */
  [data-reveal] {
    opacity: 0; transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1);
  }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  [data-reveal][data-delay="75"]  { transition-delay: 0.075s; }
  [data-reveal][data-delay="100"] { transition-delay: 0.1s; }
  [data-reveal][data-delay="150"] { transition-delay: 0.15s; }
  [data-reveal][data-delay="200"] { transition-delay: 0.2s; }
  [data-reveal][data-delay="225"] { transition-delay: 0.225s; }
  [data-reveal][data-delay="300"] { transition-delay: 0.3s; }
  [data-reveal][data-delay="375"] { transition-delay: 0.375s; }

  /* ── Typography ── */
  .ifw-eyebrow {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: #2563eb; display: flex; align-items: center; gap: 8px; margin-bottom: 0.8rem;
  }
  .ifw-eyebrow::before { content: ''; width: 24px; height: 2px; background: currentColor; display: inline-block; flex-shrink: 0; border-radius: 1px; }
  .ifw-ey-light { color: rgba(255,255,255,0.45); }
  .ifw-sh {
    font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: 700; line-height: 1.1;
    color: #040d1f; letter-spacing: -0.025em; margin-bottom: 0;
  }
  .ifw-sh em { color: #2563eb; font-style: normal; }
  .ifw-sh-light { color: #fff; }
  .ifw-sh-light em { color: #f59e0b; }
  .ifw-body-text { font-size: 0.96rem; line-height: 1.9; color: #64748b; }

  /* ── Buttons ── */
  .ifw-btn-brand {
    display: inline-flex; align-items: center; gap: 6px;
    background: #2563eb; color: #fff; padding: 0.9rem 2rem; border-radius: 100px;
    font-weight: 700; font-size: 0.92rem; text-decoration: none;
    transition: all 0.25s; box-shadow: 0 4px 20px rgba(37,99,235,0.3);
  }
  .ifw-btn-brand:hover { background: #1d4ed8; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(37,99,235,0.4); }

  .ifw-cta-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: #2563eb; color: #fff; padding: 0.9rem 2rem; border-radius: 100px;
    font-weight: 700; font-size: 0.92rem; text-decoration: none;
    transition: all 0.25s; box-shadow: 0 4px 20px rgba(37,99,235,0.4);
  }
  .ifw-cta-primary:hover { background: #1d4ed8; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(37,99,235,0.5); }

  .ifw-cta-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.8);
    padding: 0.9rem 1.8rem; border-radius: 100px; font-weight: 500; font-size: 0.92rem;
    text-decoration: none; border: 1.5px solid rgba(255,255,255,0.2); transition: all 0.25s;
  }
  .ifw-cta-ghost:hover { border-color: #f59e0b; color: #f59e0b; }

  /* ══ HERO ══════════════════════════════════════════════ */
  .ifw-hero {
    min-height: 100vh; background: #040d1f;
    position: relative; display: flex; align-items: center; overflow: hidden;
  }
  .ifw-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .ifw-glow { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); }
  .ifw-glow-1 {
    top: -10%; right: -5%; width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(37,99,235,0.25) 0%, transparent 70%);
  }
  .ifw-glow-2 {
    bottom: -15%; left: -8%; width: 450px; height: 450px;
    background: radial-gradient(circle, rgba(5,150,105,0.12) 0%, transparent 70%);
  }
  .ifw-hero-inner {
    position: relative; z-index: 2; max-width: 1180px; margin: 0 auto;
    padding: 5rem 5%; display: grid; grid-template-columns: 52% 48%;
    gap: 3rem; align-items: center; width: 100%;
  }
  .ifw-hero-left  { animation: heroUp 0.9s cubic-bezier(.16,1,.3,1) both; }
  .ifw-hero-right { animation: heroUp 0.9s cubic-bezier(.16,1,.3,1) 0.18s both; }
  @keyframes heroUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Badge */
  .ifw-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(37,99,235,0.15); border: 1px solid rgba(37,99,235,0.35);
    color: #93c5fd; font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.38rem 1rem; border-radius: 100px; margin-bottom: 1.6rem;
  }
  .ifw-badge-pulse {
    width: 7px; height: 7px; border-radius: 50%; background: #60a5fa;
    animation: bp 2.5s ease infinite; flex-shrink: 0;
  }
  @keyframes bp { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.4;transform:scale(1.6);} }

  /* H1 */
  .ifw-h1 {
    font-size: clamp(2.8rem, 5.5vw, 4.8rem); font-weight: 800; line-height: 1.04;
    color: #fff; letter-spacing: -0.03em; margin-bottom: 1.4rem;
  }
  .ifw-h1 em { color: #f59e0b; font-style: normal; display: block; }

  .ifw-hero-lead {
    font-size: 1.06rem; line-height: 1.85; color: rgba(255,255,255,0.58); max-width: 480px; margin-bottom: 2rem;
  }
  .ifw-hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }

  /* Stats strip */
  .ifw-hero-stats {
    display: flex; align-items: stretch;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; overflow: hidden; max-width: 480px;
  }
  .ifw-hstat { flex: 1; padding: 0.9rem 0.6rem; text-align: center; }
  .ifw-hstat-num { display: block; font-size: 1.55rem; font-weight: 700; color: #f59e0b; line-height: 1; }
  .ifw-hstat span { font-size: 0.6rem; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-top: 3px; line-height: 1.3; }
  .ifw-hstat-sep { width: 1px; background: rgba(255,255,255,0.07); flex-shrink: 0; }

  /* Photo mosaic */
  .ifw-mosaic {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; height: 440px; position: relative;
  }
  .ifw-mp-main {
    grid-row: 1; border-radius: 18px;
    width: 100%; height: 440px; object-fit: cover; display: block;
  }
  .ifw-mosaic-col { display: flex; flex-direction: column; gap: 10px; }
  .ifw-mosaic-col .ifw-mp { flex: 1; border-radius: 18px; width: 100%; object-fit: cover; display: block; min-height: 0; }
  .ifw-mosaic-float {
    position: absolute; bottom: -14px; right: -14px;
    background: #fff; border-radius: 14px; padding: 1rem 1.3rem;
    text-align: center; box-shadow: 0 16px 48px rgba(0,0,0,0.22); min-width: 110px; z-index: 10;
  }
  .ifw-mf-num   { font-size: 1.6rem; font-weight: 700; color: #2563eb; line-height: 1; }
  .ifw-mf-label { font-size: 0.65rem; color: #64748b; margin-top: 4px; line-height: 1.4; }

  /* ══ MARQUEE ═══════════════════════════════════════════ */
  .ifw-marquee {
    background: #fff; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;
    padding: 0.85rem 0; overflow: hidden; white-space: nowrap;
  }
  .ifw-marquee-track {
    display: inline-flex; gap: 2rem; align-items: center;
    animation: mq 32s linear infinite; padding-left: 2rem;
  }
  .ifw-marquee-track span { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; white-space: nowrap; }
  .ifw-mx { color: #cbd5e1 !important; font-weight: 400 !important; }
  @keyframes mq { 0%{transform:translateX(0);} 100%{transform:translateX(-50%);} }
  @media (prefers-reduced-motion: reduce) { .ifw-marquee-track { animation: none; } }

  /* ══ 3 PILLARS ══════════════════════════════════════════ */
  .ifw-pillars { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
  .ifw-pillar {
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px;
    padding: 2.2rem 1.8rem; transition: all 0.3s; position: relative; overflow: hidden;
  }
  .ifw-pillar::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: #2563eb; transform: scaleX(0); transform-origin: left;
    transition: transform 0.35s cubic-bezier(.16,1,.3,1);
  }
  .ifw-pillar:hover::before { transform: scaleX(1); }
  .ifw-pillar:hover { border-color: transparent; box-shadow: 0 12px 40px rgba(37,99,235,0.1); transform: translateY(-4px); }
  .ifw-pillar-icon {
    width: 52px; height: 52px; background: #eff6ff; border-radius: 14px;
    display: flex; align-items: center; justify-content: center; margin-bottom: 1.4rem; color: #2563eb;
  }
  .ifw-pillar-icon svg { width: 26px; height: 26px; }
  .ifw-pillar h3 { font-size: 1.05rem; font-weight: 700; color: #040d1f; margin-bottom: 0.6rem; }
  .ifw-pillar p  { font-size: 0.88rem; line-height: 1.75; color: #64748b; }
  .ifw-pillars-cta { text-align: center; }

  /* ══ PRODUCTS ═══════════════════════════════════════════ */
  .ifw-cat-sub {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 1.8rem; padding-bottom: 1.2rem; border-bottom: 1px solid #e2e8f0;
  }
  .ifw-cat-pill  { font-size: 0.78rem; font-weight: 700; padding: 0.35rem 1rem; border-radius: 100px; }
  .ifw-pill-blue  { background: #dbeafe; color: #1d4ed8; }
  .ifw-pill-green { background: #d1fae5; color: #065f46; }
  .ifw-cat-note { font-size: 0.84rem; color: #64748b; }
  .ifw-cat-link { margin-left: auto; font-size: 0.84rem; font-weight: 600; color: #2563eb; text-decoration: none; }
  .ifw-cat-link:hover { text-decoration: underline; }
  .ifw-cat-footer { text-align: center; font-size: 0.9rem; color: #64748b; margin-top: 2rem; }
  .ifw-cat-footer a { color: #2563eb; font-weight: 600; text-decoration: none; }
  .ifw-cat-footer a:hover { text-decoration: underline; }

  .ifw-prod-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; }
  .ifw-prod-card {
    background: #fff; border-radius: 18px; overflow: hidden;
    border: 1px solid #e2e8f0; transition: all 0.3s cubic-bezier(.16,1,.3,1);
  }
  .ifw-prod-card:hover { transform: translateY(-6px); box-shadow: 0 20px 60px rgba(0,0,0,0.1); border-color: transparent; }
  .ifw-prod-img { position: relative; height: 200px; overflow: hidden; }
  .ifw-prod-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(.16,1,.3,1); }
  .ifw-prod-card:hover .ifw-prod-img img { transform: scale(1.06); }
  .ifw-prod-badge {
    position: absolute; top: 10px; left: 10px;
    font-size: 0.6rem; font-weight: 700; padding: 0.2rem 0.6rem;
    border-radius: 100px; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .ifw-badge-hot    { background: #eff6ff; color: #1d4ed8; }
  .ifw-badge-demand { background: #fef3c7; color: #92400e; }
  .ifw-badge-pl     { background: #d1fae5; color: #065f46; }
  .ifw-badge-new    { background: #f3e8ff; color: #6b21a8; }
