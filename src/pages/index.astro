</style>

<script>
  // Scroll reveal
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObs.unobserve(e.target); }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('[data-reveal]').forEach(el => revealObs.observe(el));

  // Process timeline animated line
  const tlProg = document.getElementById('tlProgress');
  if (tlProg) {
    const tlObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { setTimeout(() => { tlProg.style.width = '100%'; }, 300); tlObs.unobserve(e.target); }
      });
    }, { threshold: 0.4 });
    const track = tlProg.closest('.ifw-tl-track') as HTMLElement | null;
    if (track) tlObs.observe(track);
  }

  // FAQ accordion
  document.querySelectorAll<HTMLButtonElement>('.ifw-faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('.ifw-faq-q').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        const a = b.nextElementSibling as HTMLElement | null;
        if (a) a.classList.remove('open');
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        const ans = btn.nextElementSibling as HTMLElement | null;
        if (ans) ans.classList.add('open');
      }
    });
  });

  // Form loading state
  const form = document.getElementById('sourcingForm') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', () => {
      const btn = form.querySelector<HTMLButtonElement>('.ifw-submit-btn');
      if (btn) { btn.textContent = 'Sending…'; btn.disabled = true; }
    });
  }
</script>
