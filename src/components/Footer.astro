---
import { site, nav, socialLinks } from '~/lib/site';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-surface-2/40">
  <div class="container-app py-12 md:py-16 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <span class="font-semibold text-fluid-lg">{site.name}</span>
      <p class="mt-3 max-w-sm text-fluid-sm text-muted">{site.tagline}</p>
      <p class="mt-4 text-fluid-sm text-muted">
        {site.address.line1}<br />{site.address.line2}
      </p>
      <p class="mt-2 text-fluid-sm text-muted">{site.locations.join(' · ')}</p>
      {socialLinks.length > 0 && (
        <div class="mt-5">
          <SocialIcons size="sm" />
        </div>
      )}
    </div>

    <nav aria-label="Footer" class="text-fluid-sm text-muted">
      <p class="font-medium text-fg">Site</p>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-copper">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-fluid-sm text-muted">
      <p class="font-medium text-fg">Get in touch</p>
      <ul class="mt-3 space-y-2">
        <li><a href={`mailto:${site.contactEmail}`} class="hover:text-copper">{site.contactEmail}</a></li>
        <li><a href={`tel:${site.phone.replace(/\s+/g, '')}`} class="hover:text-copper">{site.phone}</a></li>
        <li><a href="/legal/privacy" class="hover:text-copper">Privacy</a></li>
        <li><a href="/legal/terms" class="hover:text-copper">Terms</a></li>
      </ul>
    </div>
  </div>

  <div class="container-app py-6 border-t border-border/60 text-fluid-xs text-subtle">
    &copy; {year} {site.name}. All rights reserved.
  </div>
</footer>
