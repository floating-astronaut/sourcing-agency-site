---
import { site, nav, socialLinks } from '~/lib/site';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60 bg-bg">
  <div class="container-app py-10 md:py-12 grid gap-10 md:grid-cols-3">
    <div>
      <span class="font-semibold">{site.name}</span>
      <p class="mt-3 max-w-sm text-fluid-sm text-muted">{site.tagline}</p>
      {socialLinks.length > 0 && (
        <div class="mt-5">
          <SocialIcons size="sm" />
        </div>
      )}
    </div>

    <nav aria-label="Footer" class="text-fluid-sm text-muted">
      <p class="font-medium text-fg">Site</p>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-brand">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-fluid-sm text-muted">
      <p class="font-medium text-fg">Legal</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/legal/privacy" class="hover:text-brand">Privacy</a></li>
        <li><a href="/legal/terms" class="hover:text-brand">Terms</a></li>
      </ul>
      <p class="mt-5">
        <a href={`mailto:${site.contactEmail}`} class="hover:text-brand">{site.contactEmail}</a>
      </p>
    </div>
  </div>

  <div class="container-app py-6 border-t border-border/40 text-fluid-xs text-subtle">
    &copy; {year} {site.name}. All rights reserved.
  </div>
</footer>
