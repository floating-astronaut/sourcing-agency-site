---
import { site, nav, socialLinks } from '~/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">

    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="IndoFolk Wellness — home">
        <img src="/images/logo/ifw-mark-white.png" alt="" width="28" height="28" />
        <span class="footer-logo-text">IndoFolk <strong>Wellness</strong></span>
      </a>
      <p class="footer-tagline">{site.tagline}</p>

      <address class="footer-address">
        {site.address.line1}<br />
        {site.address.line2}
      </address>

      <div class="footer-social">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} class="footer-social-link">
            {s.name === 'Instagram' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            )}
            {s.name === 'LinkedIn' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452H17.21v-5.569c0-1.328-.024-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.985V9h3.102v1.561h.044c.432-.82 1.488-1.684 3.062-1.684 3.274 0 3.879 2.155 3.879 4.958v6.617zM5.337 7.433a1.8 1.8 0 110-3.601 1.8 1.8 0 010 3.601zM6.76 20.452H3.912V9H6.76v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {s.name === 'Facebook' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Nav column -->
    <nav aria-label="Footer navigation" class="footer-nav">
      <p class="footer-col-label">Pages</p>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Contact column -->
    <div class="footer-contact">
      <p class="footer-col-label">Get in touch</p>
      <ul>
        <li>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s+/g,'')}`}>{site.phone}</a>
        </li>
        <li>
          <a href={site.calendlyUrl} target="_blank" rel="noopener noreferrer">Book a call</a>
        </li>
      </ul>
    </div>

    <!-- Certifications / trust column -->
    <div class="footer-trust">
      <p class="footer-col-label">Our suppliers</p>
      <ul class="footer-trust-list">
        <li>GMP Certified Facilities</li>
        <li>FSSAI Licensed</li>
        <li>APEDA Registered</li>
        <li>ISO 22000 Partners</li>
        <li>Organic India Suppliers</li>
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <span>&copy; {year} {site.name}. All rights reserved.</span>
    <span class="footer-bottom-links">
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: #141E16;
    color: rgba(250,248,244,0.55);
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .site-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 4rem 5% 2.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem 2.5rem;
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .footer-logo img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .footer-logo-text {
    font-size: 0.88rem;
    font-weight: 400;
    color: rgba(250,248,244,0.70);
    white-space: nowrap;
  }
  .footer-logo-text strong { font-weight: 700; }

  .footer-tagline {
    font-size: 0.80rem;
    line-height: 1.75;
    color: rgba(250,248,244,0.40);
    max-width: 260px;
    margin-bottom: 1.2rem;
  }

  .footer-address {
    font-size: 0.78rem;
    line-height: 1.85;
    font-style: normal;
    color: rgba(250,248,244,0.35);
    margin-bottom: 1.2rem;
  }

  .footer-social {
    display: flex;
    gap: 10px;
  }
  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(250,248,244,0.12);
    color: rgba(250,248,244,0.40);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .footer-social-link:hover {
    border-color: rgba(184,150,12,0.55);
    color: #B8960C;
  }

  /* Columns */
  .footer-col-label {
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(250,248,244,0.28);
    margin-bottom: 1rem;
  }

  .footer-nav ul,
  .footer-contact ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-nav a,
  .footer-contact a {
    font-size: 0.83rem;
    color: rgba(250,248,244,0.52);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-nav a:hover,
  .footer-contact a:hover { color: #FAF8F4; }

  /* Trust list */
  .footer-trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-trust-list li {
    font-size: 0.78rem;
    color: rgba(250,248,244,0.35);
    padding-left: 1rem;
    position: relative;
  }
  .footer-trust-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #2D5A3D;
  }

  /* Bottom bar */
  .footer-bottom {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.4rem 5%;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.74rem;
    color: rgba(250,248,244,0.25);
  }
  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }
  .footer-bottom-links a {
    color: rgba(250,248,244,0.25);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-bottom-links a:hover { color: rgba(250,248,244,0.55); }

  /* Responsive */
  @media (max-width: 900px) {
    .site-footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 580px) {
    .site-footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
