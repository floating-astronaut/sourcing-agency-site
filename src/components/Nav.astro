---
import { nav, site, socialLinks } from '~/lib/site';
import SocialIcons from './SocialIcons.astro';

const { pathname } = Astro.url;
---

<a href="#main" class="skip-link">Skip to content</a>

<header
  id="site-nav"
  class="mx-auto mt-2 w-[min(calc(100%-1rem),var(--container-max))] rounded-2xl border border-border/60 bg-[linear-gradient(180deg,rgb(var(--color-bg)/0.82),rgb(var(--color-surface)/0.68))] shadow-[0_18px_44px_-28px_rgba(0,0,0,0.85)] backdrop-blur-xl"
>
  <div class="container-app flex h-[var(--nav-h)] items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-semibold min-h-11" aria-label={`${site.name} home`}>
      <span class="text-fluid-base">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-fluid-sm text-muted">
      {nav.map((item) => {
        const bare = item.href.split('#')[0] || '/';
        const active = bare !== '/' && pathname.startsWith(bare);
        return (
          <a
            href={item.href}
            class={`relative inline-flex min-h-11 items-center rounded-full px-3 transition-colors ${active ? 'text-fg' : 'hover:text-brand'}`}
            aria-current={active ? 'page' : undefined}
          >
            {active && <span class="absolute inset-x-3 bottom-1 h-px bg-brand/80"></span>}
            {item.label}
          </a>
        );
      })}
    </nav>

    {socialLinks.length > 0 && (
      <div class="hidden md:flex">
        <SocialIcons size="sm" label="Header social profiles" />
      </div>
    )}

    <a href="/#contact" class="btn btn-primary text-fluid-sm px-4 py-2.5">
      Get a Quote
    </a>
  </div>
</header>
