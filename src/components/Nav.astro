---
import { nav, site, socialLinks } from '~/lib/site';

const { pathname } = Astro.url;
---

<a href="#main" class="skip-link">Skip to content</a>

<header
  id="site-nav"
  class="border-b border-border/70 bg-bg/90 backdrop-blur-sm"
>
  <div class="container-app flex h-[var(--nav-h)] items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-semibold min-h-11" aria-label={`${site.name} home`}>
      <span class="text-fluid-lg tracking-tight">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-fluid-sm text-muted">
      {nav.map((item) => {
        const active = pathname.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`relative inline-flex min-h-11 items-center transition-colors ${active ? 'text-fg font-medium' : 'hover:text-copper'}`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    {socialLinks.length > 0 && (
      <div class="hidden lg:flex">
        <nav aria-label="Social profiles" class="flex items-center gap-3">
          {socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noreferrer" class="text-subtle hover:text-copper" aria-label={s.name}>
              <img src={s.icon} alt="" width="18" height="18" loading="lazy" />
            </a>
          ))}
        </nav>
      </div>
    )}

    <a href="/contact" class="btn btn-primary text-fluid-sm px-4 py-2.5">
      Book a Consultation
    </a>
  </div>
</header>
