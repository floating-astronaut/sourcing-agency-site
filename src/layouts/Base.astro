---
import '~/styles/global.css';
import { site } from '~/lib/site';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import JsonLd from '~/components/JsonLd.astro';
import Analytics from '~/components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'Article' | 'ContactPage' | 'AboutPage';
}

const {
  title,
  description = site.description,
  image,
  noindex = false,
  pageType = 'WebPage',
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image ?? site.ogImage, site.url).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.parent,
  url: site.url,
  description: site.description,
  address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: 'New Delhi', addressCountry: 'IN' },
  contactPoint: [{
    '@type': 'ContactPoint',
    email: site.contactEmail,
    telephone: site.phone,
    contactType: 'sales',
    areaServed: site.markets,
    availableLanguage: ['en'],
  }],
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  publisher: { '@type': 'Organization', name: site.parent },
};

const pageLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  name: fullTitle,
  url: canonical,
  description,
  image: ogImage,
  inLanguage: site.locale,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1E3B29" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href={new URL('/rss.xml', site.url).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd data={[orgLd, siteLd, pageLd]} />
    <Analytics />

    <slot name="head" />
  </head>

  <body class="bg-bg text-fg">
    <div id="header-stack" class="sticky top-0 inset-x-0 z-50">
      <Nav />
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      const loadMotion = () => import('~/lib/motion.ts').catch(() => {});
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(loadMotion, { timeout: 2000 });
      } else {
        setTimeout(loadMotion, 800);
      }
    </script>
  </body>
</html>
